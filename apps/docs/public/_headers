# Cloudflare Pages response headers. Files in public/ are copied to the root of dist/.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  # Scripts come from the site and from the origin of the analytics beacon the host adds to every page (Cloudflare Web
  # Analytics), which reports to its own origin. Inline scripts are allowed here and narrowed in each page: the build
  # writes a second policy into every page, naming the hash of each inline script and event handler the page holds
  # (src/lib/csp.mjs), and a browser enforces both. The hashes are the page's, so they cannot stand here: every page's
  # would not fit in one line. The search compiles its index's WebAssembly in a worker it makes from a blob
  # ('wasm-unsafe-eval', which allows no eval of script). No page frames a document fetched from anywhere, and no page is
  # framed: the fixture gallery's windows are documents a page writes into its frames (`srcdoc`), which are not fetched
  # and keep the page's own policy.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'

# File names carry a content hash.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

---
// The document a window of the fixtures' gallery draws (components/fixtures/FixtureGallery.astro): one fixture of a
// component, alone, as its baseline was taken — drawn from the web package's own document of the component's fixtures,
// the document its tests draw every fixture in and take each baseline from (lib/fixture-documents.ts): its stages, its
// staging rules and its step in script, with the site's own tokens, faces and components.
//
// `/fixtures/<component>/?id=<fixture>` draws that one fixture; without an `id` it draws nothing. The page is the
// windows' and no reader's: it stands outside the documentation's frame, nothing on the site links to it, the site's
// search does not index it (it has no `data-pagefind-body`), it asks search engines not to index it, and the sitemap
// leaves it out (astro.config.mjs). The scheme is the one the site's picker stored, else the system's; a window sets
// its own once it has loaded.
import '../../styles/fixture-page.css';
import { specs } from '../../lib/repo';
import { documentedComponents, fixtureDocument } from '../../lib/fixture-documents';

export function getStaticPaths() {
  return documentedComponents()
    .filter((name) => specs[name])
    .map((component) => ({ params: { component } }));
}

const spec = specs[Astro.params.component as string];
const document = fixtureDocument(spec.name)!;
const stages = document.stages.map((stage) => stage.html).join('\n');
const holder = document.page ? 'div' : 'main';
// The system the stages are drawn under (a component that lives in a layer is drawn under that layer's): its scope on the
// page, and its opt-in stylesheet.
const stylesheets = import.meta.glob<string>('../../../../../packages/web/src/generated/systems/*.css', { eager: true, query: '?url', import: 'default' });
const systemSheet = document.system ? Object.entries(stylesheets).find(([file]) => file.endsWith(`/${document.system}.css`))?.[1] : undefined;
if (document.system && !systemSheet) throw new Error(`fixtures/${spec.name}: no generated stylesheet for the system "${document.system}"`);
---

<!doctype html>
<html lang="en" data-tanrei-system={document.system}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{spec.title} · {spec.name}</title>
    <script is:inline>
      // The scheme, before the first paint: the one the site's picker stored, else the system's.
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('starlight-theme');
        } catch {}
        if (stored === 'dark' || stored === 'light') document.documentElement.dataset.tanreiTheme = stored;
      })();
    </script>
    {systemSheet && <link rel="stylesheet" href={systemSheet} />}
    <Fragment set:html={`<style>${document.styles}</style>`} />
  </head>
  <body data-component={spec.name}>
    <Fragment set:html={`<${holder} class="stages">${stages}</${holder}>`} />
    <script is:inline>
      // The one fixture asked for: every other stage goes before any component is defined.
      (() => {
        const asked = new URLSearchParams(location.search).get('id');
        for (const stage of document.querySelectorAll('body > .stages > .stage')) if (stage.dataset.fixture !== asked) stage.remove();
      })();
    </script>
    {document.after && <script is:inline type="module" set:html={document.after} />}
    <script>
      import '../../lib/register-web';
    </script>
  </body>
</html>

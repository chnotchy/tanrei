---
// A component's fixtures on a page of their own, outside the documentation's frame, drawn from the web package's own
// document of them — the document its tests draw every fixture in and take each baseline from (lib/fixture-documents.ts):
// its stages, its staging rules and its step in script, with the site's own tokens, faces and components.
//
// `/fixtures/<component>/` draws every fixture, each named by its id, and links each one that is presented over the
// window (a modal dialog), which would cover the others; `?id=<fixture>` draws that one fixture alone, as its
// baseline was taken — which is what a window stage of the gallery shows (components/fixtures/FixtureGallery.astro) and
// what its "open alone" action opens. `?theme=dark` (or `light`) sets the scheme; otherwise the page takes the site's
// (the theme the site's picker stored) and else the system's.
//
// The page is not indexed by the site's search (it has no `data-pagefind-body`) and asks search engines not to index it.
import '../../styles/fixture-page.css';
import { definedTags, specs } from '../../lib/repo';
import { drawsLive, liveFixture } from '../../lib/fixtures';
import { documentedComponents, fixtureDocument } from '../../lib/fixture-documents';

export function getStaticPaths() {
  return documentedComponents()
    .filter((name) => specs[name])
    .map((component) => ({ params: { component } }));
}

const spec = specs[Astro.params.component as string];
const document = fixtureDocument(spec.name)!;
// A fixture presented over the window: on the page of every fixture it is a link to its own window.
const live = definedTags.has(spec.platforms.web?.name ?? '') && drawsLive(spec);
const overWindow = new Set(live ? spec.fixtures.filter((fixture) => liveFixture(spec, fixture).presentation === 'overlay').map((fixture) => fixture.id) : []);
const stages = document.stages.map((stage) => (overWindow.has(stage.id) ? `<template data-presented="${stage.id}">${stage.html}</template>` : stage.html)).join('\n');
const holder = document.page ? 'div' : 'main';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{spec.title} · {spec.name}</title>
    <script is:inline>
      // The scheme, before the first paint: the address's, else the one the site's picker stored, else the system's.
      (() => {
        const query = new URLSearchParams(location.search);
        const asked = query.get('theme');
        let stored = null;
        try {
          stored = localStorage.getItem('starlight-theme');
        } catch {}
        const theme = asked === 'dark' || asked === 'light' ? asked : stored === 'dark' || stored === 'light' ? stored : null;
        if (theme) document.documentElement.dataset.tanreiTheme = theme;
        if (query.get('id')) document.documentElement.dataset.alone = '';
      })();
    </script>
    <Fragment set:html={`<style>${document.styles}</style>`} />
  </head>
  <body data-component={spec.name}>
    <Fragment set:html={`<${holder} class="stages">${stages}</${holder}>`} />
    <script is:inline>
      // One fixture alone: every other stage goes before any component is defined. On the page of every fixture, each
      // one presented over the window is a link to its own.
      (() => {
        const asked = new URLSearchParams(location.search).get('id');
        const holder = document.querySelector('body > .stages');
        if (asked) {
          for (const presented of holder.querySelectorAll('template[data-presented]')) if (presented.dataset.presented === asked) presented.replaceWith(presented.content.cloneNode(true));
          for (const stage of holder.querySelectorAll(':scope > .stage, :scope > template')) if (stage.dataset.fixture !== asked) stage.remove();
          return;
        }
        for (const presented of holder.querySelectorAll('template[data-presented]')) {
          const link = document.createElement('a');
          link.className = 'tanrei-link stage-link';
          link.dataset.fixture = presented.dataset.presented;
          link.href = `?id=${encodeURIComponent(presented.dataset.presented)}`;
          link.textContent = presented.dataset.presented;
          presented.replaceWith(link);
        }
      })();
    </script>
    {document.after && <script is:inline type="module" set:html={document.after} />}
    <script>
      import '../../lib/register-web';
    </script>
    <style is:global>
      /* Every fixture: the stages side by side and named, as the review gallery lays them out. */
      html:not([data-alone]) body > .stages {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: var(--tanrei-sys-space-space300);
        padding: var(--tanrei-sys-space-space300);
      }
      html:not([data-alone]) body > .stages > :is(.stage, .stage-link) {
        position: relative;
        margin-block-start: var(--tanrei-sys-space-space300);
        outline: var(--tanrei-sys-border-hairline) dashed var(--tanrei-sys-color-outline-variant);
      }
      html:not([data-alone]) body > .stages > .stage::before {
        content: attr(data-fixture);
        position: absolute;
        inset-block-end: 100%;
        inset-inline-start: 0;
        font: var(--tanrei-sys-typescale-code-small-font);
        color: var(--tanrei-sys-color-on-surface-variant);
        white-space: nowrap;
      }
    </style>
  </body>
</html>

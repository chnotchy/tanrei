---
// The frame of every figure the docs draw from the repository (anatomy, measurements, states, motion, color roles,
// focus order, a playground): Tanrei's Figure, written as its native parts, as a live example's is (DemoFrame.astro),
// with the figure's own controls in its header, its stage, a legend joined beneath it and a caption.
//
// - Its room is held before anything is defined. The canvas in the stage is given the room the figure will take
//   (`reserve`), as lengths of the repository's tokens, and what it shows is drawn at that size: in one row that does
//   not wrap, scrolling sideways inside the stage where the column is narrower (FIG-5), so that a narrow window cannot
//   give it more rows than were held. What the figure lays over its stage (numbers, lines, labels) is placed absolutely
//   in the overlay and drawn by script once the elements are defined (lib/visuals/frame.ts, `whenDrawn`): it takes no
//   room, and drawing it moves nothing.
// - It is drawn under the default system. A preset is behind the switch in its header (`controls`: SystemSwitch.astro),
//   whose stylesheet is loaded when its tab is pressed; a page may ask for a preset to start with (`system`), and that
//   stylesheet is linked with the figure.
// - It is named by its title before any script runs (FIG-16), and described by its legend or by the element a page
//   names (`describedBy`): the legend is the page's own markup, readable without script, and the search reads it, as it
//   reads the title and the caption. The stage is sample content (`data-pagefind-ignore`).
import ContrastSwitch from '../ContrastSwitch.astro';
import SystemSwitch from './SystemSwitch.astro';
import { figureId } from '../../lib/figure-id';
import { cssVar, ns, shippedSystems, tokensIn } from '../../lib/tokens';
import type { Hydrate } from '../../lib/visuals/frame';

/** A length: a token below the namespace (`comp.button.container.height.medium`) or a CSS length (`3rem`); a list is their sum. */
type Length = string | string[];

interface Props {
  /** The figure's title, shown in its header: words of the page's language (lib/i18n.ts `visuals`, or the page's own). */
  label: string;
  /** The room the canvas holds before anything in it is defined, from the tokens of what it draws. */
  reserve: { block: Length; inline?: Length };
  /** The system the stage is drawn under before a reader chooses: the default system unless a page asks for a preset. */
  system?: string;
  /** What the header offers: the page's contrast, the figure's design system, both, or nothing. */
  controls?: 'contrast' | 'system' | 'both' | 'none';
  /** The id of an element of the page that describes the figure at length, where it is not the legend. */
  describedBy?: string;
  /** When what the figure lays over its stage is drawn: near the view, when the browser is idle, or at once. */
  hydrate?: Hydrate;
}
const { label, reserve, system = ns, controls = 'contrast', describedBy, hydrate = 'visible' } = Astro.props;

if (!shippedSystems.some((shipped) => shipped.id === system)) throw new Error(`VisualFrame: "${system}" is not a shipped system`);
const TOKEN = /^[a-z][\w-]*(\.[\w-]+)+$/;
/** One length as CSS: a token is its custom property, after checking that the repository resolves it to a length. */
function lengthOf(piece: string): string {
  if (!TOKEN.test(piece)) return piece;
  const [token] = tokensIn(`${ns}.${piece}`);
  if (!token || token.name !== `${ns}.${piece}` || token.type !== 'dimension') throw new Error(`VisualFrame: "${piece}" is not a dimension token below ${ns}`);
  return `var(${cssVar(token.path)})`;
}
const css = (length: Length | undefined) => {
  const pieces = (Array.isArray(length) ? length : [length ?? '0px']).map(lengthOf);
  return pieces.length === 1 ? pieces[0] : `calc(${pieces.join(' + ')})`;
};

// One opt-in stylesheet per preset, each scoped to [data-tanrei-system="<id>"]: linked here only for a figure that starts
// under a preset; the switch loads the others when they are chosen.
const stylesheets = import.meta.glob<string>('../../../../../packages/web/src/generated/systems/*.css', { query: '?url', import: 'default', eager: true });
const stylesheet = system === ns ? undefined : Object.entries(stylesheets).find(([path]) => path.endsWith(`/${system}.css`))?.[1];
if (system !== ns && !stylesheet) throw new Error(`VisualFrame: no generated stylesheet for the system "${system}"`);

const id = figureId(Astro);
const legend = Astro.slots.has('legend');
const caption = Astro.slots.has('caption');
const describedByIds = [describedBy, legend ? `${id}-legend` : undefined, caption ? `${id}-caption` : undefined].filter(Boolean).join(' ') || undefined;
const room = `--docs-visual-block: ${css(reserve.block)}; --docs-visual-inline: ${css(reserve.inline)};`;
---

{stylesheet && <link rel="stylesheet" href={stylesheet} />}
<tanrei-figure class="docs-visual not-content" pattern="grid-fade" data-docs-visual data-hydrate={hydrate} data-default-system={ns}>
  <figure aria-labelledby={`${id}-title`} aria-describedby={describedByIds}>
    <div data-part="frame">
      <header>
        <p data-part="title" id={`${id}-title`}>{label}</p>
        {controls !== 'none' && (
          <div data-part="actions" data-pagefind-ignore>
            {(controls === 'system' || controls === 'both') && <SystemSwitch value={system} />}
            {(controls === 'contrast' || controls === 'both') && <ContrastSwitch />}
          </div>
        )}
      </header>
      <div data-part="stage" class="docs-visual-stage" data-tanrei-system={system === ns ? undefined : system} data-docs-visual-stage data-pagefind-ignore>
        <div class="docs-visual-canvas" style={room} data-docs-visual-canvas>
          <slot />
          <div class="docs-visual-overlay" aria-hidden="true" data-docs-visual-overlay></div>
        </div>
      </div>
      {legend && (
        <div data-part="attachment" id={`${id}-legend`}>
          <slot name="legend" />
        </div>
      )}
    </div>
    {caption && (
      <figcaption id={`${id}-caption`}>
        <slot name="caption" />
      </figcaption>
    )}
  </figure>
</tanrei-figure>

<script>
  import '../../lib/register-web';
</script>

<style>
  /* The frame, the header, the stage's box, the grid behind (the `grid-fade` pattern), the attachment and the caption
     are the Figure's (`@tanrei/web/figure.css`, which draws them before the element is defined). What follows is the
     site's own: the canvas that holds the figure's room, the overlay over it, and the scope of a preset. */
  /* As wide as the stage, and what it shows at its centre: the canvas's own box does not move when what it holds takes
     its width (an element is narrower before it is defined), and where that is wider than the stage it starts at the
     start edge and the stage scrolls (FIG-5). */
  .docs-visual-canvas {
    position: relative;
    align-self: stretch;
    box-sizing: border-box;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    justify-content: safe center;
    gap: var(--tanrei-sys-space-space200);
    min-block-size: var(--docs-visual-block);
    min-inline-size: var(--docs-visual-inline);
  }
  /* Laid over the canvas, in its box: it takes no room and catches no pointer. */
  .docs-visual-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .docs-visual-overlay:empty {
    display: none;
  }
  /* A preset's scope sets its own color-scheme (following the OS); the stage follows the site's theme instead, and draws
     the preset's surface (under the Figure's pattern, which is read in the preset's scope too). */
  .docs-visual-stage[data-tanrei-system] {
    background-color: var(--tanrei-sys-color-surface);
    color: var(--tanrei-sys-color-on-surface);
  }
  :global(:root[data-theme='light']) .docs-visual-stage[data-tanrei-system] {
    color-scheme: light;
  }
  :global(:root[data-theme='dark']) .docs-visual-stage[data-tanrei-system] {
    color-scheme: dark;
  }
  /* Custom elements have no meaningful rendering until they upgrade: they are hidden in the room held for them. */
  .docs-visual-canvas :global(:not(:defined)) {
    visibility: hidden;
  }
</style>

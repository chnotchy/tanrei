---
// The design system one figure is drawn under, chosen in its header: Tanrei's Tabs, a tab for each shipped system
// (read from the repository, the default system first), the words «Design system» before the row. A figure is drawn
// under the default system until a reader chooses another: a preset is there to be compared, behind the switch, and
// never what a figure shows first.
//
// The choice is the figure's alone: it draws the figure's stage under the system (`data-tanrei-system`), and nothing
// else of the page changes, so the choice is neither shared with another figure nor remembered. A preset's
// stylesheet is about 66 KB compressed; it is loaded when its tab is pressed, once for the page, and the stage
// changes once it has arrived, so the figure is never drawn half in one system and half in another. The page's own
// choice of system (the sidebar's select) decides what the lists show; this one decides how one figure is drawn.
//
// The row is the header's quiet one, as the contrast row is: tonal, without its track, small, and with no transition.
// What the choice reaches is said by Tanrei's Tooltip around the row and by each tab's description. Once a system is
// drawn the figure's element is told (`docs-visual-system`, from lib/visuals/frame.ts), so that a figure that draws
// over its stage draws again.
import { contentLang, strings } from '../../lib/i18n';
import { ns, shippedSystems } from '../../lib/tokens';

interface Props {
  /** The system the figure is drawn under before a reader chooses: the default system, unless a page asks for a preset. */
  value?: string;
}
const { value = ns } = Astro.props;
const t = strings(contentLang(Astro));
// One opt-in stylesheet per preset, each scoped to [data-tanrei-system="<id>"]: its address only, written on its tab
// and loaded by the script when the tab is pressed.
const stylesheets = import.meta.glob<string>('../../../../../packages/web/src/generated/systems/*.css', { query: '?url', import: 'default', eager: true });
const sheetOf = (id: string) => Object.entries(stylesheets).find(([path]) => path.endsWith(`/${id}.css`))?.[1];
for (const system of shippedSystems) if (system.id !== ns && !sheetOf(system.id)) throw new Error(`SystemSwitch: no generated stylesheet for the system "${system.id}"`);
if (!shippedSystems.some((system) => system.id === value)) throw new Error(`SystemSwitch: "${value}" is not a shipped system`);
---

<tanrei-tooltip class="docs-system-switch not-content" text={t.visuals.systemHelp} no-describe>
  <span class="docs-system-switch-set">
    <span class="docs-system-switch-word" aria-hidden="true">{t.system.choice}</span>
    <tanrei-tabs class="docs-system-switch-tabs" variant="tonal" track="false" transition="none" size="small" label={t.system.choice} value={value} data-docs-visual-system>
      {shippedSystems.map((system) => <tanrei-tab value={system.id} label={system.id} aria-description={t.visuals.systemHelp} data-sheet={system.id === ns ? undefined : sheetOf(system.id)} />)}
    </tanrei-tabs>
  </span>
</tanrei-tooltip>

<script>
  import '../../lib/register-web';
  import { drawUnder } from '../../lib/visuals/frame';

  type Row = HTMLElement & { value: string | null };

  document.addEventListener('change', (event) => {
    const row = event.target as Row;
    if (!(row instanceof HTMLElement) || !row.matches('[data-docs-visual-system]') || !row.value) return;
    const sheet = row.querySelector<HTMLElement>(`tanrei-tab[value="${CSS.escape(row.value)}"]`)?.dataset.sheet;
    const frame = row.closest<HTMLElement>('[data-docs-visual]');
    if (!frame) return;
    // Where the stylesheet could not be loaded the stage stays as it was, and the row says so again.
    const asked = row.value;
    void drawUnder(frame, asked, sheet).then((drawn) => {
      if (row.value === asked && drawn !== asked) row.value = drawn;
    });
  });
</script>

<style is:global>
  /* The same arrangement and the same rules before definition as the contrast row's (ContrastSwitch.astro): the word,
     then the row, on one line, the row under the word where a line cannot hold both; until the elements are defined, the
     room the row will take, from the tabs' own tokens of the small size. */
  .docs-system-switch {
    min-inline-size: 0;
    max-inline-size: 100%;
  }
  .docs-system-switch-set {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--tanrei-comp-figure-header-gap);
    max-inline-size: 100%;
  }
  .docs-system-switch-word {
    font: var(--tanrei-comp-tabs-label-typescale-font);
    letter-spacing: var(--tanrei-comp-tabs-label-typescale-letter-spacing);
    color: var(--tanrei-sys-color-on-surface-variant);
    white-space: nowrap;
  }
  .docs-system-switch-tabs {
    min-inline-size: 0;
    max-inline-size: 100%;
  }
  .docs-system-switch:not(:defined) {
    display: inline-block;
    vertical-align: middle;
    visibility: hidden;
  }
  .docs-system-switch-set:has(> .docs-system-switch-tabs:not(:defined)) {
    visibility: hidden;
  }
  .docs-system-switch-tabs:not(:defined) {
    box-sizing: border-box;
    display: flex;
    overflow: hidden;
    padding-inline: var(--tanrei-comp-tabs-track-padding);
    min-block-size: var(--tanrei-comp-tabs-container-height-small);
  }
  .docs-system-switch-tabs:not(:defined) > tanrei-tab {
    box-sizing: border-box;
    flex: none;
    min-inline-size: var(--tanrei-sys-target-pointer);
    padding-inline: var(--tanrei-comp-tabs-container-padding-inline-small);
    font: var(--tanrei-comp-tabs-label-typescale-font);
    letter-spacing: var(--tanrei-comp-tabs-label-typescale-letter-spacing);
    white-space: nowrap;
  }
  .docs-system-switch-tabs:not(:defined) > tanrei-tab::before {
    content: attr(label);
  }
  @media (pointer: coarse) {
    .docs-system-switch-tabs:not(:defined) > tanrei-tab {
      min-inline-size: var(--tanrei-sys-target-touch);
    }
  }
  /* Where no script runs nothing can be chosen: the control is not drawn, and takes no room. */
  @media (scripting: none) {
    .docs-system-switch:not(:defined) {
      display: none;
    }
  }
</style>

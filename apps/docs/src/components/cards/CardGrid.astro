---
// A grid of the docs' cards: one column, two where there is room. The authoring shape of Starlight's.
---

<div class="docs-card-grid"><slot /></div>

<style is:global>
  .docs-card-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--tanrei-sys-space-space200);
  }
  @media (min-width: 50rem) {
    .docs-card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Starlight's flow spacing between siblings is not for the cells of a grid. */
  .docs-card-grid > .docs-card {
    margin: 0;
  }
  /* A link card fills its cell, so the cards of one row are as tall as each other. */
  .docs-card-grid > tanrei-link-card > a {
    block-size: 100%;
  }
</style>

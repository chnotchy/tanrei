---
// A card that is one link, drawn by Tanrei's link card (`<tanrei-card href>`) with the authoring shape of
// Starlight's:
//
//   <LinkCard title="Getting started" description="Install and use Tanrei on your platform." href="/getting-started/" />
//
// The card's anchor is in its shadow root, so the page as built would hold no link. The heading therefore holds a plain
// `<a href>` — what a crawler, the search index and a reader without script follow — which is taken away when the
// element is defined and the card becomes the link (lib/link-fallback.ts).
//
// An address that leaves the site opens in a new tab, says so (`target-label`) and shows the icon set's `open_in_new`
// in place of the arrow: a card draws no mark of its own.
import { contentLang, strings } from '../../lib/i18n';
import { destination, linkAttribute } from '../../lib/link';
interface Props {
  /** The card's heading, and the link's accessible name. */
  title: string;
  /** One or two sentences under the heading. */
  description?: string;
  /** The destination: a path, a fragment or a URL. */
  href: string;
}
const { title, description, href } = Astro.props;
const { external, props } = destination(href, strings(contentLang(Astro)).opensInNewTab);
const fallback = { [linkAttribute]: '' };
---

<tanrei-card class="docs-card docs-link-card not-content" label={title} {...props}>
  <div class="docs-link-card-row">
    <div class="docs-link-card-text">
      <h3><a href={href} {...fallback}>{title}</a></h3>
      {description && <p>{description}</p>}
    </div>
    <span class="tanrei-icon" aria-hidden="true" data-pagefind-ignore data-mirror={external ? 'never' : 'always'}>{external ? 'open_in_new' : 'arrow_forward'}</span>
  </div>
</tanrei-card>

<script>
  // The card alone — not the whole package — after the anchors it replaces have gone.
  import '../../lib/link-fallback';
  import '@tanrei/web/components/card';
</script>

<style is:global>
  .docs-link-card-row {
    display: flex;
    align-items: center;
    gap: var(--tanrei-sys-space-space200);
  }
  .docs-link-card-text {
    flex: 1;
    min-inline-size: 0;
  }
  .docs-link-card-text h3 {
    margin: 0;
    font: var(--tanrei-sys-typescale-heading-5-font);
    letter-spacing: var(--tanrei-sys-typescale-heading-5-letter-spacing);
    color: inherit;
  }
  .docs-link-card-text p {
    margin: var(--tanrei-sys-space-space50) 0 0;
    font: var(--tanrei-sys-typescale-body-font);
    letter-spacing: var(--tanrei-sys-typescale-body-letter-spacing);
    color: var(--tanrei-sys-color-on-surface-variant);
  }
  .docs-link-card-row > .tanrei-icon {
    color: var(--tanrei-sys-color-on-surface-variant);
  }
  /* Until the element is defined the heading's anchor is the link, in the heading's own color; the whole card answers
     it, as it will when it is the link itself. */
  .docs-link-card:not(:defined) {
    position: relative;
  }
  .docs-link-card-text h3 > a {
    color: inherit;
    text-decoration: none;
  }
  .docs-link-card-text h3 > a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--tanrei-comp-card-container-shape);
  }
  .docs-link-card-text h3 > a:focus-visible {
    outline: none;
  }
  .docs-link-card-text h3 > a:focus-visible::after {
    outline: var(--tanrei-sys-focus-outer-width) solid var(--tanrei-sys-color-accent);
    outline-offset: var(--tanrei-sys-focus-offset);
  }
</style>

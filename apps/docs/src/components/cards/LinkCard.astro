---
// A card that is one link: Tanrei's Link card (`<tanrei-link-card>`), with the authoring shape of Starlight's:
//
//   <LinkCard title="Getting started" description="Install and use Tanrei on your platform." href="/getting-started/" />
//
// The markup is the Link card's own, written where the site is built by `linkCardToHtml()` of `@tanrei/web/links`: the
// element has no shadow root, so its anchor is in the page as built — what a crawler, the search index and a reader
// without script follow — and `@tanrei/web/link-card.css` (styles/prose.css) draws the whole card before any script
// runs. A card on the site draws no mark of its own: an address on the site shows none, and one that leaves it opens in
// a new tab, says so in its last words and shows the Link card's open_in_new.
import { linkCardToHtml } from '@tanrei/web/links';
import { contentLang, strings } from '../../lib/i18n';
import { isExternal } from '../../lib/link';
interface Props {
  /** The card's heading, and the link's accessible name. */
  title: string;
  /** One or two sentences under the heading. */
  description?: string;
  /** The destination: a path, a fragment or a URL. */
  href: string;
}
const { title, description, href } = Astro.props;
const external = isExternal(href);
const card = linkCardToHtml({ href, title, description, external: external ? 'on' : 'off' }, external ? { target: 'new', targetLabel: strings(contentLang(Astro)).opensInNewTab } : {});
// The element is the grid's cell, and it is not prose's content: the class goes on it, the one name the markup lacks.
const html = card.replace(/^<tanrei-link-card/, '<tanrei-link-card class="docs-card not-content"');
---

<Fragment set:html={html} />

<script>
  // The link card alone — not the whole package.
  import '@tanrei/web/components/link-card';
</script>

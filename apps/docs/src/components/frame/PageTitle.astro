---
// The head of a page, drawn by Tanrei's page header (specs/page-header.spec.json) in place of the
// framework's title: this component replaces Starlight's `PageTitle`. First in the main region:
//
//   the breadcrumbs   Tanrei's breadcrumbs (specs/breadcrumbs.spec.json), from the sidebar's own
//                     hierarchy — the language's first page, the groups the page stands in, the page itself. A group
//                     is a link where it has a page of its own (Components, Getting started) and plain text where it
//                     has none. The page itself is the last level, not a link, `aria-current="page"`;
//   the title         the page's own `h1`, with the id the framework's anchors know;
//   the description   the page's `description` from its front matter, which until now only the head of the document
//                     and the search carried. On a component's page it is that page's summary, in the reader's
//                     language: the spec's own sentence is not printed a second time under it;
//   the meta line     one item: when the page last changed, a `<time>` whose `datetime` is the date the sitemap
//                     gives the page (src/lib/lastmod.mjs, through its virtual module: one value, read once) and
//                     whose text says that day in the page's language (PGH-8): the build writes its UTC day, the
//                     day the sitemap names, and a script right after the head writes the reader's own day in its
//                     place before the first frame, so a reader in Tokyo and one in Los Angeles may each see their
//                     own day for the same instant (src/lib/reader-day.mjs). The words are in the `<time>` too:
//                     one run of text, which the meta line draws as text, not as a glyph beside its label (an item
//                     with an element inside is laid out as one). No other date: a page says when it last
//                     changed, not when it was first written. A page no commit holds yet has no meta line. The
//                     search does not index it: a date is not what a reader searches a page for;
//   the actions       on every page that has its Markdown beside it: copy it, view it, open it in a chat, add the MCP
//                     server to an editor (PageActions.astro), beside the title while the head is wide and under its
//                     text while it is narrow (PGH-10). They are no text of the page: neither the search nor the page's
//                     Markdown reads them.
//
// Under the head of a component's page stand the facts of its spec — category, token namespace, its level and,
// where it is built from other components, their names, each a link to its page — as Tanrei's
// description list (specs/description-list.spec.json), stacked in columns: a layout its stylesheet draws alone, so
// the facts are in their final place before the element is defined.
//
// A component that others are built from says where ("Used in": every component whose `builtFrom` names it), and one
// a list shows only on request (`listing`) leads with one line — Tanrei's Callout, between the head and
// the facts — that says so and links to what most products place in its stead.
// The level and that mark are also given to the search index as the page's own facts (`data-pagefind-meta`), which
// the search's results say (components/frame/Search.astro).
//
// The page header's stylesheet and the breadcrumbs' draw all of it before their elements are defined
// (styles/frame.css loads them); the elements add the landmark, the list and the folding of a trail that does not fit.
// The id the framework gives the page's title (its constant is not exported): anchors to the top of a page name it.
const PAGE_TITLE_ID = '_top';
import { frameWords, homeHref, trail, type Entry } from './frame';
import { localeBase, strings } from '../../lib/i18n';
import { updatedParts } from '../../lib/dated';
import { readerDayScript } from '../../lib/reader-day.mjs';
import { lastUpdated } from 'virtual:tanrei-docs/last-updated';
import { aroundPlace, isNotFoundPage, levelFacts, listingFacts, specOfPage } from '../../lib/page-head';
import Callout from '../Callout.astro';
import PageActions from './PageActions.astro';

const route = Astro.locals.starlightRoute;
const words = frameWords(Astro);
const t = strings(route.lang);
const { title, description } = route.entry.data;
const lastChanged = lastUpdated(Astro.url.pathname);
const updated = lastChanged ? updatedParts(lastChanged, route.lang) : undefined;
const [beforeDate, afterDate] = aroundPlace(t.updated, 'date');
const spec = specOfPage(route.id);
const levelOf = spec && levelFacts(spec, route.lang, localeBase(Astro));
const listingOf = spec && listingFacts(spec, localeBase(Astro));
const [beforeInstead, afterInstead] = aroundPlace(t.listing.placedInstead, 'components');
// What the search index keeps of the page beside its words: the level, and the mark of a component shown on request.
// One fact to an element: the index reads everything after a key's colon as its value.
const indexLevel = levelOf && `level:${levelOf.level}`;
const indexOnRequest = listingOf?.onRequest ? `onrequest:${t.listing.advanced}` : undefined;
const levels = route.hasSidebar ? trail(route.sidebar as unknown as Entry[]) : [];
// The page that was not found has no head: the empty state in its main region holds its heading (components/NotFound.astro).
const head = !isNotFoundPage(route.id);
// A page the search reads has its Markdown beside it (lib/page-markdown.mjs), and the actions that copy and open it.
const actions = head && route.entry.data.pagefind !== false;
---

{head && (
<tanrei-page-header class="docs-page-header">
  <tanrei-breadcrumbs label={words.breadcrumbs} overflow-label={words.hiddenLevels} data-pagefind-ignore>
    <a href={homeHref(route)} data-icon="home">{words.home}</a>
    {levels.map((level) => (level.href ? <a href={level.href}>{level.label}</a> : <span>{level.label}</span>))}
    <span aria-current="page">{title}</span>
  </tanrei-breadcrumbs>
  <h1 id={PAGE_TITLE_ID}>{title}</h1>
  {description && <p>{description}</p>}
  {updated && (
    <div data-part="meta" data-pagefind-ignore>
      <time datetime={updated.datetime} data-day={updated.text}>{beforeDate}{updated.text}{afterDate}</time>
    </div>
  )}
  {actions && <PageActions />}
</tanrei-page-header>
)}
{/* The reader's own day in place of the UTC day, before the first frame: inline, right after the head, which it finds
    as the element before it (src/lib/reader-day.mjs). Without script the UTC day stays. */}
{head && updated && <script is:inline set:html={readerDayScript} />}
{/* The snackbars the actions say what they copied in (components/frame/PageActions.astro): defined by that script when
    the actions are first about to be used, not with the page. */}
{actions && <tanrei-snackbar-host class="docs-snackbars" data-define-on-use data-pagefind-ignore></tanrei-snackbar-host>}
{listingOf?.onRequest && (
  <Callout type="note" title={t.listing.advanced}>
    {listingOf.placedInstead.length > 0 && (
      <p>{beforeInstead}{listingOf.placedInstead.map((member, at) => (<>{at > 0 && ', '}{member.href ? <a class="tanrei-link" href={member.href}>{member.title}</a> : member.title}</>))}{afterInstead}</p>
    )}
  </Callout>
)}
{spec && (
  <tanrei-description-list class="docs-page-facts" layout="stacked" columns="3" density="compact" separation="gap" data-pagefind-meta={indexLevel}>
    <dl data-pagefind-meta={indexOnRequest}>
      <div><dt>{t.category_}</dt><dd>{t.category[spec.category] ?? spec.category}</dd></div>
      <div><dt>{t.tokens}</dt><dd><code class="tanrei-code" data-variant="plain" translate="no" spellcheck="false">{spec.tokens}</code></dd></div>
      {levelOf && <div><dt>{t.level_}</dt><dd>{levelOf.level}</dd></div>}
      {levelOf && levelOf.builtFrom.length > 0 && (
        <div>
          <dt>{t.builtFrom}</dt>
          {/* One value: the members in the spec's order, a comma and a space between two, so that a reader and the search index read names and not one word. */}
          <dd>{levelOf.builtFrom.map((member, at) => (<>{at > 0 && ', '}{member.href ? <a class="tanrei-link" href={member.href}>{member.title}</a> : member.title}</>))}</dd>
        </div>
      )}
      {listingOf && listingOf.usedIn.length > 0 && (
        <div>
          <dt>{t.usedIn}</dt>
          <dd>{listingOf.usedIn.map((member, at) => (<>{at > 0 && ', '}{member.href ? <a class="tanrei-link" href={member.href}>{member.title}</a> : member.title}</>))}</dd>
        </div>
      )}
    </dl>
  </tanrei-description-list>
)}

<script>
  import '@tanrei/web/components/page-header';
  import '@tanrei/web/components/breadcrumbs';
  import '@tanrei/web/components/description-list';
</script>

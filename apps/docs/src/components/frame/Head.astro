---
// The document's head: the framework's own tags, and before them a preload for each font file the page's first
// screen is set in (lib/first-faces.mjs says which, and why: text first drawn in a fallback family is drawn again when
// the file arrives, and what stands under it moves).
//
// The families come from the tokens. The files are the ones styles/fonts.generated.css registers them from — the same
// file, so the same address in the built site — and a family the tokens name that has no file here stops the build:
// add its Latin file below (test/first-faces.test.mjs reads this list against the registered faces).
//
// The icon family's file is not preloaded. It is small (the families are cut down to the site's glyphs) and is asked
// for as soon as a glyph is laid out; preloaded, it took the slow line from the stylesheets and the text faces, and the
// largest paint of a throttled mobile page came 0.7 s later, with the page's load no sooner.
//
// And it holds the page's first module script (lib/link-fallback.ts): module scripts run in the order they stand, each
// once its whole graph has arrived, and this one must be waiting for the link forms' elements before any other defines
// one.
//
// A component's page also names its version in Markdown, in English, in every language (src/lib/llms.ts):
// `<link rel="alternate" type="text/markdown">`, for a program that reads the page.
import Default from '@astrojs/starlight/components/Head.astro';
import inter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import robotoMono from '@fontsource-variable/roboto-mono/files/roboto-mono-latin-wght-normal.woff2?url';
import { firstFamilies } from '../../lib/first-faces.mjs';
import { markdownAlternate } from '../../lib/llms';
import { ns, tokensIn } from '../../lib/tokens';

const FILES: Record<string, string> = { Inter: inter, 'Roboto Mono': robotoMono };

const stacks = Object.fromEntries(tokensIn(`${ns}.ref.typeface`).filter((token) => token.type === 'fontFamily').map((token) => [token.path.at(-1), [token.value].flat() as string[]]));
const files = firstFamilies(stacks).map((family) => {
  const file = FILES[family];
  if (!file) throw new Error(`Head.astro: the tokens set text in "${family}", and no file of it is preloaded. Add its Latin file.`);
  return file;
});
const markdown = markdownAlternate(Astro.locals.starlightRoute.id);
const english = Astro.locals.starlightRoute.lang === 'en';
---

{files.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
{markdown && <link rel="alternate" type="text/markdown" href={markdown} hreflang={english ? undefined : 'en'} />}
<Default />

<script>
  import '../../lib/link-fallback';
</script>

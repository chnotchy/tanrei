---
// The document's head: the framework's own tags, and before them a preload for each font file the page's first
// screen is set in (lib/first-faces.mjs says which, and why: text first drawn in a fallback family is drawn again when
// the file arrives, and what stands under it moves).
//
// The families come from the tokens. The files are the ones styles/fonts.generated.css registers them from — the same
// file, so the same address in the built site — and a family the tokens name that has no file here stops the build:
// add its Latin file below (test/first-faces.test.mjs reads this list against the registered faces).
//
// The icon family's file is not preloaded. It is small (the families are cut down to the site's glyphs) and is asked
// for as soon as a glyph is laid out; preloaded, it took the slow line from the stylesheets and the text faces, and the
// largest paint of a throttled mobile page came 0.7 s later, with the page's load no sooner.
//
// And it holds the page's first module script that waits for elements (lib/link-fallback.ts): module scripts run in the
// order they stand, each once its whole graph has arrived, and this one must be waiting for the link forms' elements
// before any other defines one. (The appearance's module, ThemeProvider.astro, may run before it: it defines none.)
//
// And it names the page's version in Markdown, `<path>.md` beside the page, for a program that reads the page
// (`<link rel="alternate" type="text/markdown">`): every page the site's search reads has one, written from it when the
// site is built (lib/page-markdown.mjs). A page left out of the search (the page that was not found) has none.
import Default from '@astrojs/starlight/components/Head.astro';
import inter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import robotoMono from '@fontsource-variable/roboto-mono/files/roboto-mono-latin-wght-normal.woff2?url';
import { firstFamilies } from '../../lib/first-faces.mjs';
import { markdownPathOf } from '../../lib/page-markdown.mjs';
import { sampleGlyph } from '../../lib/repo';
import { translations } from '../../../i18n/locales.mjs';
import { ns, tokensIn } from '../../lib/tokens';

const FILES: Record<string, string> = { Inter: inter, 'Roboto Mono': robotoMono };

const stacks = Object.fromEntries(tokensIn(`${ns}.ref.typeface`).filter((token) => token.type === 'fontFamily').map((token) => [token.path.at(-1), [token.value].flat() as string[]]));
const files = firstFamilies(stacks).map((family) => {
  const file = FILES[family];
  if (!file) throw new Error(`Head.astro: the tokens set text in "${family}", and no file of it is preloaded. Add its Latin file.`);
  return file;
});
// Icons are not drawn until their font can draw them. A glyph of the icon set is a ligature: while its font is not there
// the browser spells its name in a text face, and the face's `font-display: block` hides that only for the block
// period (about 3 s; on a slower line the names were drawn). So a script inline in the head sets the web package's switch,
// `--tanrei-icon-visibility: hidden`, on the root before anything is drawn — every glyph the package's stylesheets draw
// in the light DOM then keeps its box and is not painted, and nothing moves when it is taken off — and takes it off once
// each icon family the tokens name (unselected, selected) draws a glyph as one ligature: a name measured in a box that
// is not drawn, about one em wide once the font draws it (the web package's own test of a glyph, primitives/glyph.ts).
// Laying the probes out asks for the faces at once; the switch comes off in the frame a probe's width changes to one
// em. Once the page has loaded, `document.fonts.load` waits for each family's face to arrive or fail: a family that
// cannot draw then never will.
//
// A page whose font fails to load, or names a family no face is registered for, keeps its icons hidden — a ligature's
// name is no picture of the icon, and the components' own marks draw nothing in that case either (CHK-19) — and says
// so in the console once the page has loaded. A page whose script does not run never sets the switch, and has the
// browser's `font-display: block`.
const iconsReady = `(() => {
  const root = document.documentElement;
  if (!document.fonts || typeof ResizeObserver !== 'function') return;
  const SWITCH = '--tanrei-icon-visibility';
  const FAMILIES = ['--tanrei-sys-icon-family-unselected', '--tanrei-sys-icon-family-selected'];
  const GLYPH = ${JSON.stringify(sampleGlyph)};
  const EM = 24;
  root.style.setProperty(SWITCH, 'hidden');
  let probes = [];
  const drawn = () => probes.every((probe) => { const width = probe.getBoundingClientRect().width; return width > 0 && width <= EM * 1.5; });
  const sizes = new ResizeObserver(() => drawn() && ready());
  const ready = () => {
    sizes.disconnect();
    for (const probe of probes) probe.remove();
    probes = [];
    root.style.removeProperty(SWITCH);
  };
  const measure = () => {
    probes = FAMILIES.map((family) => {
      const probe = document.createElement('span');
      probe.setAttribute('aria-hidden', 'true');
      probe.setAttribute('data-docs-icon-probe', '');
      probe.textContent = GLYPH;
      probe.style.cssText = 'position: absolute; inset-block-start: 0; inset-inline-start: 0; visibility: hidden; pointer-events: none; white-space: nowrap; font: normal ' + EM + 'px/1 var(' + family + '); letter-spacing: normal; font-feature-settings: \\'liga\\'; text-transform: none';
      return document.body.appendChild(probe);
    });
    if (drawn()) return ready();
    for (const probe of probes) sizes.observe(probe);
    // Once the page has loaded, every stylesheet has registered its faces: each family is asked for, and the loads
    // settle once its face has arrived or failed. A family still not drawn then will not be.
    const loaded = new Promise((resolve) => (document.readyState === 'complete' ? resolve() : addEventListener('load', resolve, { once: true })));
    loaded.then(() => {
      const style = getComputedStyle(root);
      const stacks = [...new Set(FAMILIES.map((family) => style.getPropertyValue(family).trim()).filter(Boolean))];
      return Promise.allSettled(stacks.map((stack) => document.fonts.load(EM + 'px ' + stack, GLYPH))).then(() => {
        if (!probes.length) return;
        if (drawn()) return ready();
        console.warn('[docs] The icon font cannot draw (' + stacks.join(', ') + '): it failed to load, or no face is registered for it. Icons stay hidden rather than drawn as their names.');
      });
    });
  };
  if (document.body) measure();
  else addEventListener('DOMContentLoaded', measure, { once: true });
})();`;
const route = Astro.locals.starlightRoute;
const markdown = route.entry.data.pagefind === false ? undefined : markdownPathOf(Astro.url.pathname, translations.map(({ dir }) => dir));
---

{files.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
{markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
<link rel="describedby" href="/llms.txt" />
<Default />
<script is:inline set:html={iconsReady} />

<script>
  import '../../lib/link-fallback';
</script>

---
// The site's header, drawn by Tanrei's app bar (specs/app-bar.spec.json) in place of the framework's row: this
// component replaces Starlight's `Header`, and with it its `SiteTitle`, `ThemeSelect`, `LanguageSelect` and
// `SocialIcons`. PageFrame.astro puts it in the shell's `<header>`.
//
//   the menu button   the bar's navigation item, at every width, on pages that have a sidebar: the navigation's one
//                     menu button, so the drawer has no row of its own for one. Two icon-only Buttons that look the
//                     same take turns by the shell's window class: in a compact window the shell's own menu button
//                     (`data-app-shell-menu`, APS-6, APS-7), which opens the drawer over the content; in a wider one
//                     the site's, which asks the drawer for its other form — collapsed or expanded where it stands
//                     beside the content, opened over it where it is a column (its presentation, NVD-53) — and says
//                     which, as the drawer's own menu button would (NVD-37);
//   the brand         the bar's brand (APB-19 to APB-23): a link to the language's first page (`brand-href`) named by
//                     the site's name (`brand-label`), drawn as Tanrei's wordmark (design/brand/wordmark.svg, inline,
//                     in `comp.app-bar.brand.color`) at every width — the name is read here, so the wordmark, never
//                     the symbol. Until the bar is defined the image holds the box the bar will give it
//                     (styles/frame.css). The bar's own title (`headline`) is text and a heading: a site's name leads
//                     home and is not a heading of the page, so the bar is given none;
//   the appearance    the bar's context (APB-25): a text Button that says the reader's look — the design system the
//                     docs are drawn in, Tanrei's own or a showcase system — and opens the Appearance panel
//                     (Appearance.astro): the color mode, the contrast and the look, a link to this page as it looks
//                     now, and Theme Studio's link. The choice is lib/appearance.ts's, which the head's script applies
//                     before the first paint; every example of every page follows it (components/visuals/Example.astro),
//                     and so do the lists of components (lib/list-filter.ts). A compact window has no room for it beside
//                     the wordmark and the actions: there the same button and panel stand first in the drawer's list
//                     (Sidebar.astro), and the bar's is not drawn;
//   the repository    an icon-only Button that is a link to the source repository on GitHub (lib/repository.ts, from
//                     tanrei.config.json), the first action, which says that it leaves the site. Nothing is fetched
//                     from GitHub: no count, no picture but the mark drawn here;
//   the search        Tanrei's Search as the bar's first action (Search.astro): a button trigger with its shortcut
//                     that opens a dialog, and in a compact window an icon-only Button that opens the full-screen
//                     view; the site's search index answers it;
//   the mode          an icon-only toggle Button, "Dark mode": on while the page is dark, and a press shows the other
//                     scheme and keeps it as the reader's mode (the device's mode is chosen in the panel);
//   the language      an icon-only Button that opens a Menu of links — a language is a place to go, the same page
//                     at another address, and a list of places is a menu of links, never options.
//
// The bar hides what does not fit (`overflow="hide"`, APB-26, APB-30): the search, the mode and the language are never
// taken out (`app-bar-overflow="never"`), so the repository's link is the one action that leaves where the row has no
// room for it — every page's foot links the repository too (Footer.astro). It stands first among the actions, so that
// whether it is drawn moves nothing else, and until the bar is defined, and where no script runs, it is not drawn
// (styles/frame.css). The bar holds one navigation item: of the two menu buttons, only the one of the window's
// class is given its slot (the other's stays unassigned, and the bar draws nothing of it), first by the script that
// follows the bar, before the bar is defined, then whenever the class changes. Until the bar is defined, and where no
// script runs, the stylesheet shows the one or the other (styles/frame.css).
//
// The menus stand beside the bar, not in it: the bar draws its own slots only, and a menu is drawn where it is
// written (its surface is in the top layer).
import Search from './Search.astro';
import { translations, source } from '../../../i18n/locales.mjs';
import { frameWords, homeHref } from './frame';
import { inlineMark } from '../../lib/brand.mjs';
import { frameOf } from '../../lib/brand-geometry.mjs';
import { marks } from '../../lib/brand-marks';
import Appearance from './Appearance.astro';
import { repositoryHref } from '../../lib/repository';
import { strings } from '../../lib/i18n';

const route = Astro.locals.starlightRoute;
const words = frameWords(Astro);
const { externalLink } = strings(route.lang);

// The same page in each language: the address without this language's folder, under the other's.
const here = route.locale ? Astro.url.pathname.replace(new RegExp(`^/${route.locale}(?=/|$)`), '') || '/' : Astro.url.pathname;
// The wordmark at the height the bar draws a wordmark at (comp.app-bar.brand.wordmark.height, 40 in the default
// system), held by its attributes before any stylesheet arrives; its shapes are in `currentColor`.
const WORDMARK_HEIGHT = 40;
const frame = frameOf(marks.wordmark);
const wordmark = inlineMark(marks.wordmark, { width: Math.round((WORDMARK_HEIGHT * frame.width) / frame.height), height: WORDMARK_HEIGHT, slot: 'brand-wordmark', class: 'docs-brand', role: 'img', 'aria-label': route.siteTitle, focusable: 'false', translate: 'no' });
const languages = [{ dir: '', lang: source.lang, label: source.label }, ...translations].map(({ dir, lang, label }) => ({ lang, label, href: dir ? `/${dir}${here}` : here, current: (route.locale ?? '') === dir }));
---

<tanrei-app-bar class="docs-app-bar" brand-href={homeHref(route)} brand-label={route.siteTitle} overflow="hide">
  {
    route.hasSidebar && (
      <>
        <tanrei-button slot="navigation" class="docs-compact-only" data-docs-slot="navigation" data-app-shell-menu variant="text" label={words.menu}>
          <span slot="icon">menu</span>
        </tanrei-button>
        <tanrei-button slot="navigation" id="docs-drawer-toggle" class="docs-wide-only" data-docs-slot="navigation" variant="text" label={words.menu} aria-controls="docs-sidebar" aria-expanded="true">
          <span slot="icon">menu</span>
        </tanrei-button>
      </>
    )
  }
  <Fragment set:html={wordmark} />
  <Appearance id="docs-appearance" part="button" slot="context" />
  {/* GitHub's mark (Octicons' mark-github), in the current color. */}
  <tanrei-button slot="actions" id="docs-repository" variant="text" href={repositoryHref} label={words.repository} aria-description={externalLink}>
    <svg slot="icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"></path></svg>
  </tanrei-button>
  <Search />
  <tanrei-button slot="actions" id="docs-mode" variant="text" toggle label={words.darkMode} app-bar-overflow="never">
    <span slot="icon">dark_mode</span>
  </tanrei-button>
  <tanrei-button slot="actions" id="docs-language" variant="text" label={words.language} app-bar-overflow="never">
    <span slot="icon">translate</span>
  </tanrei-button>
</tanrei-app-bar>
<Appearance id="docs-appearance" part="panel" />
<tanrei-menu class="docs-frame-menu" anchor="docs-language" placement="bottom-end">
  {languages.map(({ lang, label, href, current }) => <tanrei-menu-item lang={lang} label={label} href={href} current={current || undefined} />)}
</tanrei-menu>
{/* The appearance's messages (a link copied, a shared appearance): defined on first use. */}
<tanrei-snackbar-host class="docs-appearance-snackbars" data-define-on-use data-pagefind-ignore data-shared={words.shared} data-keep={words.keepShared} data-close={words.close}></tanrei-snackbar-host>

{
  /* Before first paint: the appearance the head's script applied to the root, as the controls' starting values (an
   attribute is what an element starts from) — the look's name on its button, the panel's choices, the mode's toggle
   — and the bar's menu button for the window's class, read from the shell's stylesheet — before the bar is defined,
   so that it never holds both. */
}
<script is:inline>
  {
    const frame = document.currentScript.parentElement;
    const root = document.documentElement;
    const look = root.getAttribute('data-docs-system');
    if (look) {
      for (const button of frame.querySelectorAll('.docs-look')) {
        // The reader's own theme is named by its word ("My theme"), not by its look's id.
        const name = look === 'custom' ? button.dataset.customName : look;
        button.querySelector('.docs-look-name').textContent = name;
        button.setAttribute('label', button.dataset.label.replace('{look}', name));
      }
      for (const list of frame.querySelectorAll('.docs-appearance-look')) list.setAttribute('value', look);
    }
    const mode = root.getAttribute('data-docs-mode');
    if (mode) for (const tabs of frame.querySelectorAll('.docs-appearance-mode')) tabs.setAttribute('value', mode);
    const contrast = root.getAttribute('data-tanrei-contrast');
    if (contrast) for (const tabs of frame.querySelectorAll('.docs-appearance-contrast')) tabs.setAttribute('value', contrast);
    if (root.getAttribute('data-theme') === 'dark') frame.querySelector('#docs-mode')?.setAttribute('selected', '');
    const bar = frame.querySelector('tanrei-app-bar.docs-app-bar');
    if (bar) {
      const compact = getComputedStyle(bar).getPropertyValue('--tanrei-app-shell-window-class').trim() === 'compact';
      for (const item of bar.querySelectorAll(':scope > .docs-wide-only, :scope > .docs-compact-only')) {
        if (item.classList.contains('docs-compact-only') === compact) item.setAttribute('slot', item.dataset.docsSlot);
        else item.removeAttribute('slot');
      }
    }
  }
</script>

<script>
  import '@tanrei/web/components/app-bar';
  import '@tanrei/web/components/button';
  import '@tanrei/web/components/menu';
  import '../../lib/list-filter';
  import { CUSTOM_LOOK, isShared, keepShared, linkTo, onAppearance, placeCustomChoices, setAppearance, shownAppearance, type Appearance, type Contrast, type Mode } from '../../lib/appearance';

  type Choice = HTMLElement & { value: string | null };
  type Panel = HTMLElement & { open: boolean };
  const root = document.documentElement;

  // ── The appearance ────────────────────────────────────────────────────────────────────────────────────────────────
  // Every control says what is shown: the look's buttons (the bar's, and the drawer's of a compact window), every
  // panel's choices and the mode's toggle. (The index's select of the system its lists show says it itself: SystemSelect.astro.)
  /** A choice's value: its property once the element is defined, its attribute (what it starts from) until then. */
  const choose = (control: Choice, value: string) => {
    if (customElements.get(control.localName)) control.value = value;
    else control.setAttribute('value', value);
  };
  const say = (appearance: Appearance) => {
    placeCustomChoices();
    for (const button of document.querySelectorAll<HTMLElement>('tanrei-button.docs-look')) {
      const look = appearance.look === CUSTOM_LOOK ? (button.dataset.customName ?? appearance.look) : appearance.look;
      const name = button.querySelector('.docs-look-name');
      if (name) name.textContent = look;
      button.setAttribute('label', (button.dataset.label ?? '{look}').replace('{look}', look));
    }
    for (const tabs of document.querySelectorAll<Choice>('tanrei-tabs.docs-appearance-mode')) choose(tabs, appearance.mode);
    for (const tabs of document.querySelectorAll<Choice>('tanrei-tabs.docs-appearance-contrast')) choose(tabs, appearance.contrast);
    for (const list of document.querySelectorAll<Choice>('tanrei-list.docs-appearance-look')) choose(list, appearance.look);
    const toggle = document.getElementById('docs-mode') as (HTMLElement & { selected: boolean }) | null;
    if (toggle) toggle.selected = root.getAttribute('data-theme') === 'dark';
  };
  say(shownAppearance());
  onAppearance(({ appearance }) => say(appearance));
  // Whether this browser keeps a theme of the reader's own may change in another tab (Theme Studio's Share menu).
  addEventListener('storage', () => queueMicrotask(placeCustomChoices));

  // A choice in any panel is the reader's appearance from here on.
  document.addEventListener('change', (event) => {
    const control = event.target as Choice;
    if (!(control instanceof HTMLElement) || !control.value) return;
    if (control.matches('tanrei-tabs.docs-appearance-mode')) setAppearance({ mode: control.value as Mode });
    else if (control.matches('tanrei-tabs.docs-appearance-contrast')) setAppearance({ contrast: control.value as Contrast });
    else if (control.matches('tanrei-list.docs-appearance-look')) setAppearance({ look: control.value });
  });

  // The mode's toggle: the other scheme than the one shown, kept as the reader's mode.
  document.getElementById('docs-mode')?.addEventListener('change', (event) => {
    setAppearance({ mode: (event as CustomEvent<{ selected: boolean }>).detail.selected ? 'dark' : 'light' });
  });

  // The panel's elements are defined when a reader is first about to open it — a pointer over its button, focus on
  // it, or a press — so that a page whose panel is never opened never loads them.
  let panelDefined: Promise<unknown> | undefined;
  const definePanel = () =>
    (panelDefined ??= Promise.all([import('@tanrei/web/components/popover'), import('@tanrei/web/components/tabs'), import('@tanrei/web/components/list'), import('@tanrei/web/components/list-row'), import('@tanrei/web/components/swatch')]).then(() => customElements.whenDefined('tanrei-popover')));
  // A panel opens and closes when it asks to (a press on its button asks through toggle, POP-18; Escape and a press
  // outside through close, POP-21). A panel not drawn yet hears no press: the press that defines it opens it.
  for (const panel of document.querySelectorAll<Panel>('tanrei-popover.docs-appearance-panel')) {
    const button = document.getElementById(panel.getAttribute('anchor') ?? '');
    button?.addEventListener('pointerenter', definePanel, { once: true });
    button?.addEventListener('focusin', definePanel, { once: true });
    button?.addEventListener('click', async () => {
      if ((panel as Panel & { hasUpdated?: boolean }).hasUpdated) return;
      await definePanel();
      panel.open = true;
    });
    panel.addEventListener('toggle', (event) => {
      panel.open = (event as unknown as CustomEvent<{ open: boolean }>).detail.open;
    });
    panel.addEventListener('close', () => {
      panel.open = false;
    });
  }

  // ── What the appearance says in a Snackbar: a link copied, and a page opened with a shared appearance ─────────────
  type Host = HTMLElement & { show(options: { message: string; action?: string; status?: 'default' | 'error'; statusLabel?: string; closable?: boolean; closeLabel?: string; duration?: string }): Promise<{ result: string }> };
  const host = () => document.querySelector<Host>('tanrei-snackbar-host.docs-appearance-snackbars');
  let defined: Promise<unknown> | undefined;
  const defineHost = () => (defined ??= import('@tanrei/web/components/snackbar').then(() => customElements.whenDefined('tanrei-snackbar-host')));
  const tell = async (options: Parameters<Host['show']>[0]) => {
    const firstUse = !customElements.get('tanrei-snackbar-host');
    await defineHost();
    // A live region that has just entered the document is not heard yet: it is given two frames before it speaks.
    if (firstUse) await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
    return host()?.show(options);
  };

  // The copy of a link to this page as it looks now.
  for (const copy of document.querySelectorAll<HTMLElement>('.docs-appearance-copy')) {
    copy.addEventListener('pointerenter', defineHost, { once: true });
    copy.addEventListener('focusin', defineHost, { once: true });
    copy.addEventListener('click', async () => {
      const panel = copy.closest<HTMLElement>('tanrei-popover');
      try {
        await navigator.clipboard.writeText(linkTo(location.href, shownAppearance()));
        void tell({ message: panel?.dataset.copied ?? '' });
      } catch {
        void tell({ message: panel?.dataset.copyFailed ?? '', status: 'error' });
      }
    });
  }

  // A page opened with a shared appearance shows it, and offers to keep it; closed, the page goes on showing it, and
  // the next page the reader's own.
  if (isShared()) {
    const words = document.querySelector<HTMLElement>('tanrei-snackbar-host.docs-appearance-snackbars');
    void tell({ message: words?.dataset.shared ?? '', action: words?.dataset.keep, closable: true, closeLabel: words?.dataset.close, duration: 'indefinite' }).then((result) => {
      if (result?.result === 'action') keepShared();
    });
  }

  // The bar's menu button follows the window's class (the script after the bar chose it before the bar was defined):
  // the button of the class has its slot, and the other none, so the bar holds one navigation item.
  const bar = document.querySelector('tanrei-app-bar.docs-app-bar');
  const arrange = (windowClass: string) => {
    const compact = windowClass.trim() === 'compact';
    for (const item of bar?.querySelectorAll<HTMLElement>(':scope > .docs-wide-only, :scope > .docs-compact-only') ?? []) {
      if (item.classList.contains('docs-compact-only') === compact) item.setAttribute('slot', item.dataset.docsSlot ?? '');
      else item.removeAttribute('slot');
    }
  };
  const shell = bar?.closest('tanrei-app-shell');
  shell?.addEventListener('windowclasschange', (event) => arrange((event as CustomEvent<{ windowClass: string }>).detail.windowClass));
  const decided = shell?.getAttribute('data-window-class');
  if (decided) arrange(decided);

  // The site's menu button of a wider window: it asks the drawer for its other form, as the drawer's own menu button
  // would (NVD-37) — collapsed or expanded where the drawer stands beside the content, open over it where the drawer
  // is a column — and says whether the navigation is expanded.
  type Drawer = HTMLElement & { presentation: string | null; expanded: boolean; open: boolean };
  const toggle = document.getElementById('docs-drawer-toggle');
  const drawer = document.getElementById('docs-sidebar') as Drawer | null;
  if (toggle && drawer) {
    const say = () => toggle.setAttribute('aria-expanded', String(drawer.presentation === 'column' ? drawer.open : drawer.expanded));
    toggle.addEventListener('click', () => {
      if (drawer.presentation === 'column') drawer.open = !drawer.open;
      else if (drawer.presentation === 'standard') drawer.expanded = !drawer.expanded;
      say();
    });
    for (const type of ['presentationchange', 'expandedchange', 'close']) drawer.addEventListener(type, () => queueMicrotask(say));
    void customElements.whenDefined('tanrei-navigation-drawer').then(say);
  }

  // A menu opens from its button and closes when it asks to (the menu never closes itself, MNU-1).
  for (const menu of document.querySelectorAll<HTMLElement & { open: boolean }>('tanrei-menu.docs-frame-menu')) {
    const button = document.getElementById(menu.getAttribute('anchor') ?? '');
    if (!button) continue;
    button.setAttribute('aria-haspopup', 'menu');
    button.addEventListener('click', () => {
      menu.open = !menu.open;
    });
    menu.addEventListener('close', () => {
      menu.open = false;
    });
  }
</script>

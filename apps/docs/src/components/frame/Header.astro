---
// The site's header, drawn by Tanrei's app bar (specs/app-bar.spec.json) in place of the framework's row: this
// component replaces Starlight's `Header`, and with it its `SiteTitle`, `ThemeSelect`, `LanguageSelect` and
// `SocialIcons` (the link to the source repository stands at the foot of every page, Footer.astro). PageFrame.astro puts it in the shell's `<header>`.
//
//   the menu button   an icon-only Button the shell shows only while the navigation has no place in the layout, and
//                     answers (`data-app-shell-menu`, APS-6);
//   the site's mark   a Tanrei Link to the language's first page, beside the menu button, drawn as the brand's
//                     symbol (design/brand/symbol.svg, inline, in on-surface) with the site's name as its text for
//                     assistive technology: the symbol stands where the name is not read, and never beside the
//                     wordmark or the name set as text. It sits in an icon button's box at an icon's size, so its
//                     centre and inset are the menu button's and the actions'. The bar's own title (`headline`) is
//                     text and a heading: a site's name leads home and is not a heading of the page, so the bar is
//                     given none;
//   the search        Tanrei's Search as the bar's first action (Search.astro): a button trigger with its shortcut
//                     that opens a dialog, and in a compact window an icon-only Button that opens the full-screen
//                     view; the site's search index answers it;
//   the theme         a small Select with its label hidden: one of three values, kept on this device under the key
//                     the framework's own theme script reads before first paint;
//   the language      an icon-only Button that opens a Menu of links — a language is a place to go, the same page
//                     at another address, and a list of places is a menu of links, never options.
//
// A compact window has no room for five items (and a bar holds three actions, APB-13): there the theme and the
// language are one icon-only Button that opens one Menu — the theme as a group of radio items, the languages as a
// group of links. The shell's window class shows one arrangement or the other (styles/frame.css); the two theme
// controls are kept alike by the script below.
//
// The menus stand beside the bar, not in it: the bar draws its own slots only, and a menu is drawn where it is
// written (its surface is in the top layer).
import Search from './Search.astro';
import { translations, source } from '../../../i18n/locales.mjs';
import { strings } from '../../lib/i18n';
import { frameWords, homeHref } from './frame';
import { inlineMark } from '../../lib/brand.mjs';
import { marks } from '../../lib/brand-marks';

const route = Astro.locals.starlightRoute;
const words = frameWords(Astro);
const t = strings(route.lang);

// The same page in each language: the address without this language's folder, under the other's.
const here = route.locale ? Astro.url.pathname.replace(new RegExp(`^/${route.locale}(?=/|$)`), '') || '/' : Astro.url.pathname;
// The symbol at the icon size it is drawn at (sys.icon.medium, styles/frame.css), held by its attributes before the
// stylesheet arrives; its shapes are in `currentColor`.
const symbol = inlineMark(marks.symbol, { width: 24, height: 24, class: 'docs-site-mark', 'aria-hidden': 'true', focusable: 'false' });
const languages = [{ dir: '', lang: source.lang, label: source.label }, ...translations].map(({ dir, lang, label }) => ({ lang, label, href: dir ? `/${dir}${here}` : here, current: (route.locale ?? '') === dir }));
---

<tanrei-app-bar class="docs-app-bar">
  {
    route.hasSidebar && (
      <tanrei-button slot="navigation" data-app-shell-menu variant="text" label={words.menu}>
        <span slot="icon">menu</span>
      </tanrei-button>
    )
  }
  <a slot="navigation" class="tanrei-link docs-site-title" data-standalone data-underline="never" href={homeHref(route)} translate="no"><Fragment set:html={symbol} /><span class="sr-only">{route.siteTitle}</span></a>
  <Search />
  <tanrei-select slot="actions" class="docs-theme docs-wide-only" size="small" label={words.theme} label-hidden value="auto">
    <tanrei-option value="auto" leading-icon="computer">{words.themeAuto}</tanrei-option>
    <tanrei-option value="light" leading-icon="light_mode">{t.light}</tanrei-option>
    <tanrei-option value="dark" leading-icon="dark_mode">{t.dark}</tanrei-option>
  </tanrei-select>
  <tanrei-button slot="actions" id="docs-language" class="docs-wide-only" variant="text" label={words.language}>
    <span slot="icon">translate</span>
  </tanrei-button>
  <tanrei-button slot="actions" id="docs-more" class="docs-compact-only" variant="text" label={words.themeAndLanguage}>
    <span slot="icon">more_vert</span>
  </tanrei-button>
</tanrei-app-bar>
<tanrei-menu class="docs-frame-menu" anchor="docs-language" placement="bottom-end">
  {languages.map(({ lang, label, href, current }) => <tanrei-menu-item lang={lang} label={label} href={href} current={current || undefined} />)}
</tanrei-menu>
<tanrei-menu class="docs-frame-menu" anchor="docs-more" placement="bottom-end">
  <tanrei-menu-group class="docs-theme-group" label={words.theme} value="auto">
    <tanrei-menu-radio-item value="auto" label={words.themeAuto} leading-icon="computer" />
    <tanrei-menu-radio-item value="light" label={t.light} leading-icon="light_mode" />
    <tanrei-menu-radio-item value="dark" label={t.dark} leading-icon="dark_mode" />
  </tanrei-menu-group>
  <tanrei-menu-group label={words.language}>
    {languages.map(({ lang, label, href, current }) => <tanrei-menu-item lang={lang} label={label} href={href} current={current || undefined} />)}
  </tanrei-menu-group>
</tanrei-menu>

{/* Before first paint: the reader's stored theme as the select's value (the attribute is what the element starts from). */}
<script is:inline>
  try {
    const theme = localStorage.getItem('starlight-theme');
    if (theme === 'light' || theme === 'dark') for (const control of document.currentScript.parentElement.querySelectorAll('.docs-theme, .docs-theme-group')) control.setAttribute('value', theme);
  } catch {}
</script>

<script>
  import '@tanrei/web/components/app-bar';
  import '@tanrei/web/components/button';
  import '@tanrei/web/components/select';
  import '@tanrei/web/components/menu';

  // The theme: the framework's script in the head has already applied the stored choice (`data-theme` on the root,
  // which styles/tanrei-theme.css turns into `color-scheme`). Here the select changes it, stores it under the same
  // key, and follows the system while the choice is "auto".
  const KEY = 'starlight-theme';
  const system = matchMedia('(prefers-color-scheme: light)');
  const stored = () => {
    try {
      const theme = localStorage.getItem(KEY);
      return theme === 'light' || theme === 'dark' ? theme : 'auto';
    } catch {
      return 'auto';
    }
  };
  const apply = (theme: string) => {
    document.documentElement.dataset.theme = theme === 'light' || theme === 'dark' ? theme : system.matches ? 'light' : 'dark';
  };
  // The select of a wider window and the radio group of a compact one: a change of either is the reader's choice,
  // and the other is set to it (setting `value` from script fires no `change`).
  const controls = [...document.querySelectorAll<HTMLElement & { value: string }>('tanrei-select.docs-theme, tanrei-menu-group.docs-theme-group')];
  for (const control of controls) {
    control.addEventListener('change', () => {
      const theme = control.value;
      for (const other of controls) if (other !== control) other.value = theme;
      apply(theme);
      try {
        localStorage.setItem(KEY, theme === 'light' || theme === 'dark' ? theme : '');
      } catch {}
    });
  }
  system.addEventListener('change', () => {
    if (stored() === 'auto') apply('auto');
  });

  // A menu opens from its button and closes when it asks to (the menu never closes itself, MNU-1).
  for (const menu of document.querySelectorAll<HTMLElement & { open: boolean }>('tanrei-menu.docs-frame-menu')) {
    const button = document.getElementById(menu.getAttribute('anchor') ?? '');
    if (!button) continue;
    button.setAttribute('aria-haspopup', 'menu');
    button.addEventListener('click', () => {
      menu.open = !menu.open;
    });
    menu.addEventListener('close', () => {
      menu.open = false;
    });
  }
</script>

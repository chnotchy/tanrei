---
// Theme Studio lives in @tanrei/studio; this page only hosts it: a root element, and a script that mounts the
// Studio in the page's language. The Studio's chrome reads Tanrei's default tokens from :root (Starlight's customCss
// loads them), so nothing a visitor edits restyles the site — edits apply inside the Studio's preview scope only.
//
// The page's language is passed as it is. The Studio speaks the languages it has a dictionary for
// (packages/studio/src/strings/); a page in a language it has none for yet hosts it in English, and its link still leads to that language's page. On a right-to-left page the
// Studio stands in the page's direction; it sets one itself only where its host has not.
//
// The Studio's stylesheets are the host's to load (packages/studio/src/index.ts). The web package's four it draws with
// — the icon class, the tree view, the accordion, the description list — are the site's, on every page, in the docs'
// layers (astro.config.mjs, styles/prose.css). The Studio's own is linked here, so that it is on this page only: a
// stylesheet a script imports is given to every page of the site that the script's bundle reaches.
import studioCss from '@tanrei/studio/studio.css?url';
import { localeBase } from '../lib/i18n';
const lang = Astro.currentLocale ?? 'en';
const layers = `${localeBase(Astro)}/foundations/design-systems/`;
---

<link rel="stylesheet" href={studioCss} />
{/* The page's content column is prose, and prose spaces the blocks of every section and div inside it. The Studio is
    a tool of its own boxes, not a text: an island of the prose (PRS-16), so that nothing inside it takes prose's
    rhythm — its segments, panes and rows stood a block gap out of line before it was one. */}
<div class="tanrei-not-prose" data-theme-studio data-lang={lang} data-layers={layers}></div>
{/* The Studio is a tool, not a page of text: it takes the whole width inside the frame's gutters. Said to the shell
    while the page is parsed — before the first paint — so that nothing changes width when the Studio mounts. */}
<script is:inline>
  document.currentScript.closest('tanrei-app-shell')?.setAttribute('main-width', 'full');
</script>

<style>
  /* The Studio's place is held before its script has run: the tool is taller than the window at every level, so what
     follows it on the page is below the fold from the first paint and does not move when it arrives. */
  [data-theme-studio] {
    min-block-size: 100svh;
  }
</style>

<script>
  import { mountStudio } from '@tanrei/studio';
  import fullIcons from '../styles/icons-full.generated.css?url';
  for (const root of document.querySelectorAll<HTMLElement>('[data-theme-studio]')) {
    mountStudio(root, { lang: root.dataset.lang, links: { layers: root.dataset.layers } });
  }
  // The site's icon families are registered from files cut down to the glyphs its pages draw, at the weights the
  // shipped systems use (styles/fonts.generated.css). A layer edited here may draw its icons at any weight, which
  // only the full files hold: they are registered too — once the page has loaded, so that their 5 MB is not part of
  // its load — and, registered last, they are the faces the icons are drawn in from then on.
  const full = () => document.head.append(Object.assign(document.createElement('link'), { rel: 'stylesheet', href: fullIcons }));
  if (document.readyState === 'complete') full();
  else addEventListener('load', full, { once: true });
</script>

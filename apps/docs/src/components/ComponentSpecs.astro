---
// Specs tab: everything here is read from specs/<name>.spec.json and the component token group. Every table is Tanrei's
// Table (Table.astro), named by the heading above it; the two name mappings keep their first column, which names the
// row, in view while the platforms scroll under it, and the tokens are at the compact density.
import { componentHref, getSpec, memberOf, platforms, definedTags, type Forwarded } from '../lib/repo';
import { tokensIn, sharedSetsOf, sourceAlias, formatValue, ns } from '../lib/tokens';
import { contentLang, localeBase, strings } from '../lib/i18n';
import SourceNote from './SourceNote.astro';
import Table from './Table.astro';
import NameTag from './NameTag.astro';
import { drawsFixture, drawsLive, liveFixture } from '../lib/fixtures';

interface Props {
  name: string;
}
const spec = getSpec(Astro.props.name);
const t = strings(contentLang(Astro));

// The component's own group first, then every set of tokens it reads that is no component's (the input box, proposal
// 0149): each row names its custom property, so the family a token is of is read from its name.
const groups = [spec.tokens, ...sharedSetsOf(spec.name)];
const compTokens = groups.flatMap((group) => tokensIn(`${ns}.${group}`).filter((tk) => tk.type !== 'typography'));
const typographyTokens = groups.flatMap((group) => tokensIn(`${ns}.${group}`).filter((tk) => tk.type === 'typography'));

const webName = spec.platforms.web?.name;
const defined = webName && definedTags.has(webName);
const live = defined && drawsLive(spec);
// The opener of a presented fixture is the system's own button (its tag from the button spec).
const Button = getSpec('button').platforms.web?.name as any;
const showDefault = (v: unknown) => (v === null ? 'null' : typeof v === 'string' ? `"${v}"` : String(v));
const mapped = [
  ...spec.props.map((p) => ({ kind: t.property, name: p.name, key: 'props' as const })),
  ...(spec.events ?? []).map((e) => ({ kind: t.event, name: e.name, key: 'events' as const })),
];
const itemMapped = (kind: NonNullable<typeof spec.items>[number]) => [
  ...kind.props.map((p) => ({ kind: t.property, name: p.name, key: 'props' as const })),
  ...(kind.events ?? []).map((e) => ({ kind: t.event, name: e.name, key: 'events' as const })),
];
// A prop, an event or a slot a composed component takes from a member: the description is the member's
// own, and after it stand the member — its title, linked to its page — and the sentence the composed spec adds.
const base = localeBase(Astro);
const member = (entry: Forwarded) => {
  const name = memberOf(entry);
  return name ? { title: getSpec(name).title, href: componentHref(base, name) } : undefined;
};
const noteHtml = (notes: string | undefined) => (notes ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>');
---

<h3>{t.anatomy}</h3>
<Table label={t.anatomy}><table>
  <thead><tr><th scope="col">{t.part}</th><th scope="col">{t.description}</th></tr></thead>
  <tbody>
    {spec.anatomy.map((part, i) => (
      <tr>
        <td data-wrap="false"><span class="num">{i + 1}</span> <code>{part.id}</code>{part.optional && <em class="docs-muted"> · {t.optional}</em>}</td>
        <td>{part.description}</td>
      </tr>
    ))}
  </tbody>
</table></Table>

<h3>{t.props}</h3>
<Table label={t.props}><table>
  <thead><tr><th scope="col">{t.property}</th><th scope="col">{t.type}</th><th scope="col">{t.default_}</th><th scope="col">{t.description}</th></tr></thead>
  <tbody>
    {spec.props.map((prop) => (
      <tr>
        <td data-wrap="false"><code>{prop.name}</code></td>
        <td>
          {prop.values
            ? prop.values.map((v, i) => (<>{i > 0 && ' | '}<code>{v}</code></>))
            : <code>{prop.type}</code>}
        </td>
        <td data-wrap="false"><code>{showDefault(prop.default)}</code></td>
        <td>{prop.description}{member(prop) && <span class="docs-muted from"> — {member(prop)!.href ? <a class="tanrei-link" href={member(prop)!.href}>{member(prop)!.title}</a> : member(prop)!.title}</span>}{prop.note && <> {prop.note}</>}</td>
      </tr>
    ))}
  </tbody>
</table></Table>

{spec.slots && spec.slots.length > 0 && (
  <>
    <h3>{t.slots}</h3>
    <Table label={t.slots}><table>
      <thead><tr><th scope="col">{t.slot}</th><th scope="col">{t.description}</th></tr></thead>
      <tbody>
        {spec.slots.map((slot) => (<tr><td><code>{slot.name}</code></td><td>{slot.description}{member(slot) && <span class="docs-muted from"> — {member(slot)!.href ? <a class="tanrei-link" href={member(slot)!.href}>{member(slot)!.title}</a> : member(slot)!.title}</span>}{slot.note && <> {slot.note}</>}</td></tr>))}
      </tbody>
    </table></Table>
  </>
)}

{spec.events && spec.events.length > 0 && (
  <>
    <h3>{t.events}</h3>
    <Table label={t.events}><table>
      <thead><tr><th scope="col">{t.event}</th><th scope="col">{t.description}</th></tr></thead>
      <tbody>
        {spec.events.map((event) => (<tr><td><code>{event.name}</code></td><td>{event.description}{member(event) && <span class="docs-muted from"> — {member(event)!.href ? <a class="tanrei-link" href={member(event)!.href}>{member(event)!.title}</a> : member(event)!.title}</span>}{event.note && <> {event.note}</>}</td></tr>))}
      </tbody>
    </table></Table>
  </>
)}

{spec.items && spec.items.length > 0 && (
  <>
    <h3>{t.items}</h3>
    <p class="docs-muted">{t.itemsHelp}</p>
    {spec.items.map((kind) => (
      <>
        <h4><code>{kind.name}</code>{kind.container && <em class="docs-muted"> · {t.container}</em>}</h4>
        <p>{kind.summary}</p>
        {kind.props.length > 0 && (
          <Table label={`${kind.name} · ${t.props}`}><table>
            <thead><tr><th scope="col">{t.property}</th><th scope="col">{t.type}</th><th scope="col">{t.default_}</th><th scope="col">{t.description}</th></tr></thead>
            <tbody>
              {kind.props.map((prop) => (
                <tr>
                  <td data-wrap="false"><code>{prop.name}</code></td>
                  <td>
                    {prop.values
                      ? prop.values.map((v, i) => (<>{i > 0 && ' | '}<code>{v}</code></>))
                      : <code>{prop.type}</code>}
                  </td>
                  <td data-wrap="false"><code>{showDefault(prop.default)}</code></td>
                  <td>{prop.description}</td>
                </tr>
              ))}
            </tbody>
          </table></Table>
        )}
        {kind.slots && kind.slots.length > 0 && (
          <Table label={`${kind.name} · ${t.slots}`}><table>
            <thead><tr><th scope="col">{t.slot}</th><th scope="col">{t.description}</th></tr></thead>
            <tbody>
              {kind.slots.map((slot) => (<tr><td><code>{slot.name}</code></td><td>{slot.description}</td></tr>))}
            </tbody>
          </table></Table>
        )}
        {kind.events && kind.events.length > 0 && (
          <Table label={`${kind.name} · ${t.events}`}><table>
            <thead><tr><th scope="col">{t.event}</th><th scope="col">{t.description}</th></tr></thead>
            <tbody>
              {kind.events.map((event) => (<tr><td><code>{event.name}</code></td><td>{event.description}</td></tr>))}
            </tbody>
          </table></Table>
        )}
        <Table label={`${kind.name} · ${t.mapping}`} rowHeaders stickyFirstColumn><table>
          <thead>
            <tr>
              <th scope="col">{t.specName}</th>
              {platforms.map((p) => <th scope="col">{t.platform[p] ?? p}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="docs-muted">{t.item}</th>
              {platforms.map((p) => <td><code>{spec.platforms[p]?.items?.[kind.name]?.name ?? '—'}</code></td>)}
            </tr>
            {itemMapped(kind).map((m) => (
              <tr>
                <th scope="row" data-wrap="false"><code>{m.name}</code> <span class="docs-muted">· {m.kind}</span></th>
                {platforms.map((p) => <td><code>{spec.platforms[p]?.items?.[kind.name]?.[m.key]?.[m.name] ?? '—'}</code></td>)}
              </tr>
            ))}
            {platforms.some((p) => spec.platforms[p]?.items?.[kind.name]?.notes) && (
              <tr>
                <th scope="row" class="docs-muted">{t.notes}</th>
                {platforms.map((p) => <td class="note" set:html={noteHtml(spec.platforms[p]?.items?.[kind.name]?.notes)} />)}
              </tr>
            )}
          </tbody>
        </table></Table>
      </>
    ))}
  </>
)}

<h3>{t.states}</h3>
{/* The states are Tanrei's Tag group of small outlined tags (NameTag.astro): names, not controls. A space parts two
    tags for the search index. */}
<tanrei-tag-group class="states docs-name-tags not-content" spacing="tags" label={t.states}>
  {spec.states.map((state) => <><NameTag label={state} />{' '}</>)}
</tanrei-tag-group>

<h3>{t.behavior}</h3>
<p class="docs-muted">{t.behaviorHelp}</p>
<Table label={t.behavior}><table class="behavior">
  <thead><tr><th scope="col">{t.id}</th><th scope="col">{t.requirement}</th></tr></thead>
  <tbody>
    {spec.behavior.map((b) => (<tr id={b.id.toLowerCase()}><td><code>{b.id}</code></td><td>{b.text}</td></tr>))}
  </tbody>
</table></Table>

<h3>{t.mapping}</h3>
<p class="docs-muted">{t.mappingHelp}</p>
<Table label={t.mapping} rowHeaders stickyFirstColumn><table>
  <thead>
    <tr>
      <th scope="col">{t.specName}</th>
      {platforms.map((p) => <th scope="col">{t.platform[p] ?? p}</th>)}
    </tr>
  </thead>
  <tbody>
    <tr>
      <th scope="row" class="docs-muted">{t.component}</th>
      {platforms.map((p) => <td><code>{spec.platforms[p]?.name ?? '—'}</code></td>)}
    </tr>
    {mapped.map((m) => (
      <tr>
        <th scope="row" data-wrap="false"><code>{m.name}</code> <span class="docs-muted">· {m.kind}</span></th>
        {platforms.map((p) => <td><code>{spec.platforms[p]?.[m.key]?.[m.name] ?? '—'}</code></td>)}
      </tr>
    ))}
    {platforms.some((p) => spec.platforms[p]?.notes) && (
      <tr>
        <th scope="row" class="docs-muted">{t.notes}</th>
        {platforms.map((p) => <td class="note" set:html={noteHtml(spec.platforms[p]?.notes)} />)}
      </tr>
    )}
  </tbody>
</table></Table>

<h3>{t.tokens}</h3>
<Table label={t.tokens} density="compact"><table>
  <thead><tr><th scope="col">{t.token}</th><th scope="col">{t.aliases}</th><th scope="col">{t.resolvedLight}</th></tr></thead>
  <tbody>
    {[...compTokens, ...typographyTokens].map((tk) => {
      const alias = sourceAlias(tk.name);
      return (
        <tr>
          <td data-wrap="false"><code>{tk.cssVar}</code></td>
          <td>{alias ? <code>{alias.replace(`${ns}.`, '')}</code> : <span class="docs-muted">—</span>}</td>
          <td>
            {tk.type === 'color' && <span class="chip" style={`background:${tk.value.hex}`} aria-hidden="true" />}
            <span class="docs-mono">{formatValue(tk)}</span>
          </td>
        </tr>
      );
    })}
  </tbody>
</table></Table>

<h3>{t.fixtures}</h3>
<p class="docs-muted">{t.fixturesHelp}</p>
<Table label={t.fixtures}><table class="fixtures">
  <thead><tr><th scope="col">{t.fixture}</th><th scope="col">{t.props}</th><th scope="col">{t.live}</th></tr></thead>
  <tbody>
    {spec.fixtures.map((f) => (
      <tr>
        <td><code>{f.id}</code></td>
        <td><code>{JSON.stringify(f.props)}</code></td>
        {/* A fixture drawn in place is an example, not text of the page: the search index does not read it (as DemoFrame's stage). */}
        <td class="live" data-tanrei-demo data-pagefind-ignore>
          {live && drawsFixture(spec, f) ? (() => {
            const lf = liveFixture(spec, f);
            return (
              <div
                class="fixture"
                data-presentation={lf.presentation}
                data-inline={lf.inline ? '' : undefined}
                data-open-prop={lf.openProp}
                data-close-events={lf.closeEvents.join(' ')}
                data-toggle-events={lf.toggleEvents.join(' ')}
              >
                <div class="fixture-element" set:html={lf.html} />
                {lf.presentation !== 'none' && (
                  <Button class="fixture-opener" variant="outlined" label={`${t.open} ${f.id}`}>{t.open}</Button>
                )}
              </div>
            );
          })() : <span class="docs-muted">{live || !defined ? t.notDefinedYet : t.notDrawnHere}</span>}
        </td>
      </tr>
    ))}
  </tbody>
</table></Table>
<SourceNote files={[`specs/${spec.name}.spec.json`, ...groups.map((group) => `tokens/comp/${group.replace('comp.', '')}.tokens.json`), 'design/tokens/']} />

<script>
  import '../lib/register-web';

  // The controller of presented fixtures (their presentation is decided in ../lib/fixtures.ts). It does what a product
  // does with the component: opens it from its opener, and sets it closed again from its close, dismiss and toggle events.
  type Presentable = HTMLElement & { updateComplete?: Promise<unknown> } & Record<string, unknown>;
  const frame = () => new Promise((resolve) => requestAnimationFrame(() => resolve(undefined)));

  /** Whether anything the element draws is in the top layer (a popover or a modal dialog), which no box can hold. */
  function inTopLayer(element: HTMLElement): boolean {
    const walk = (root: ParentNode): boolean =>
      [...root.querySelectorAll<HTMLElement>('*')].some((node) => node.matches(':popover-open, dialog:modal') || (!!node.shadowRoot && walk(node.shadowRoot)));
    return (element.shadowRoot ? walk(element.shadowRoot) : false) || walk(element);
  }

  /** Everything the element draws, through its shadow trees: each drawn box, and whether any is placed against the window. */
  function drawn(element: HTMLElement): { rects: DOMRect[]; fixed: boolean } {
    const rects = [element.getBoundingClientRect()];
    let fixed = false;
    const walk = (root: ParentNode) => {
      for (const node of root.querySelectorAll<HTMLElement>('*')) {
        const r = node.getBoundingClientRect();
        if (r.width > 0 && r.height > 0 && node.checkVisibility({ visibilityProperty: true, opacityProperty: true })) {
          rects.push(r);
          if (getComputedStyle(node).position === 'fixed') fixed = true;
        }
        if (node.shadowRoot) walk(node.shadowRoot);
      }
    };
    if (element.shadowRoot) walk(element.shadowRoot);
    walk(element);
    return { rects: rects.filter((r) => r.width > 0 && r.height > 0), fixed };
  }

  /** How far what the element draws reaches past each side of its box (0 where it stays inside). */
  function overflow(element: HTMLElement, box: HTMLElement) {
    const b = box.getBoundingClientRect();
    const { rects, fixed } = drawn(element);
    const reach = (f: (r: DOMRect) => number) => Math.max(0, ...rects.map(f));
    return {
      fixed,
      top: reach((r) => b.top - r.top),
      bottom: reach((r) => r.bottom - b.bottom),
      left: reach((r) => b.left - r.left),
      right: reach((r) => r.right - b.right),
    };
  }
  const escapes = (o: ReturnType<typeof overflow>) => o.fixed || o.top > 1 || o.bottom > 1 || o.left > 1 || o.right > 1;

  /** Whether a node is the element or inside it, through shadow roots. */
  function within(element: HTMLElement, node: Node | null | undefined): boolean {
    for (let n = node; n; n = n.parentNode ?? (n as ShadowRoot).host) if (n === element) return true;
    return false;
  }

  /** Until what the element runs has finished (an opening slide), for at most a second: its layout is then its own. */
  async function settled(element: HTMLElement) {
    const running = document.getAnimations().filter((a) => within(element, (a.effect as KeyframeEffect | null)?.target));
    await Promise.race([Promise.all(running.map((a) => a.finished.catch(() => undefined))), new Promise((r) => setTimeout(r, 1000))]);
  }

  async function control(box: HTMLElement) {
    const element = box.querySelector<Presentable>('.fixture-element > *');
    const opener = box.querySelector<HTMLElement>('.fixture-opener');
    const prop = box.dataset.openProp;
    if (!element || !prop) return;
    await customElements.whenDefined(element.localName);
    await element.updateComplete;
    // A component that stands beside an anchor it does not wrap (a popover) and names none here takes the fixture's opener.
    if (opener && 'anchorElement' in element && !element.hasAttribute('anchor')) element.anchorElement = opener;

    const isOpen = () => element[prop] === true;
    const sync = () => {
      box.dataset.state = isOpen() ? 'open' : 'closed';
    };
    /**
     * After a close: the opener shows again, and focus that was lost with what closed goes back to it. A fixture drawn
     * with the `inline` test attribute draws its surface whatever `open` says, so it loses the attribute when it closes:
     * closed, it is the real component again (a FAB menu's toggle, a search bar), and its opener draws it in place again.
     */
    const closed = async () => {
      if (box.dataset.inline !== undefined && box.dataset.presentation === 'inplace') element.removeAttribute('inline');
      await element.updateComplete;
      sync();
      await frame();
      await settled(element);
      let active = document.activeElement;
      while (active?.shadowRoot?.activeElement) active = active.shadowRoot.activeElement;
      const lost = !active || active === document.body || active.getClientRects().length === 0 || !active.checkVisibility({ visibilityProperty: true });
      // An overlay was opened from its opener, so focus goes back there even where the component keeps it (a search bar).
      const kept = box.dataset.presentation === 'overlay' && within(element, active);
      if (opener && (lost || kept)) opener.focus();
    };
    const setOpen = (value: boolean) => {
      element[prop] = value;
      if (value) sync();
      else closed();
    };

    for (const name of (box.dataset.closeEvents ?? '').split(' ').filter(Boolean)) {
      element.addEventListener(name, (event) => {
        if (event.target === element && !event.defaultPrevented) setOpen(false);
      });
    }
    for (const name of (box.dataset.toggleEvents ?? '').split(' ').filter(Boolean)) {
      element.addEventListener(name, (event) => {
        if (event.target !== element) return;
        const detail = (event as CustomEvent<{ open?: boolean; expanded?: boolean }>).detail;
        const value = detail?.open ?? detail?.expanded;
        if (typeof value === 'boolean') setOpen(value);
      });
    }
    // An overlay's action closes it, as a product's handler would.
    element.addEventListener('click', (event) => {
      if ((event.target as Element | null)?.closest?.('[data-fixture-action]')) setOpen(false);
    });
    opener?.addEventListener('click', () => {
      if (box.dataset.inline !== undefined && box.dataset.presentation === 'inplace') element.setAttribute('inline', '');
      setOpen(true);
    });

    if (box.dataset.presentation === 'check') {
      // Drawn open but hidden, then placed by what it draws:
      // 1. inside its cell as it is;
      // 2. or with room made around it for what reaches past its box (a FAB menu's items above the toggle);
      // 3. or, if it fills its parent or is placed against the window (a standard sheet, a drawer), on a stage that stands
      //    for the window: the containing block of its fixed and absolute parts, clipping them;
      // 4. or, if it is still in the top layer (a tooltip, a popover) or closed by itself before it could be placed, as an
      //    overlay: closed, with its opener.
      const stage = box.querySelector<HTMLElement>('.fixture-element')!;
      const settle = async () => {
        await element.updateComplete;
        await frame();
        await settled(element);
        await frame();
      };
      // Hidden until then: first by visibility, which also hides what reaches the top layer; once nothing is there, by a
      // clip instead, so that what the element hides itself (a picker's year grid) can be told from what it shows.
      await element.updateComplete;
      await frame();
      if (isOpen() && !inTopLayer(element)) {
        box.dataset.measuring = '';
        await settle();
      }
      let o = overflow(element, box);
      // An element with no size of its own fills its parent: room around it does not help, a stage does.
      const own = element.getBoundingClientRect();
      const fillsParent = own.width === 0 || own.height === 0;
      if (isOpen() && !inTopLayer(element) && escapes(o) && !o.fixed && !fillsParent) {
        stage.style.padding = `${o.top}px ${o.right}px ${o.bottom}px ${o.left}px`;
        await settle();
        o = overflow(element, box);
      }
      if (isOpen() && !inTopLayer(element) && escapes(o)) {
        stage.style.padding = '';
        stage.classList.add('window');
        await settle();
      }
      delete box.dataset.measuring;
      if (!isOpen() || inTopLayer(element)) {
        stage.classList.remove('window');
        element[prop] = false;
        await element.updateComplete;
        box.dataset.presentation = 'overlay';
      } else {
        box.dataset.presentation = 'inplace';
      }
    }
    sync();
  }

  for (const box of document.querySelectorAll<HTMLElement>('.fixture[data-open-prop]')) control(box);

  /**
   * A fixture's step in script (`STAGED_FILES` in lib/fixtures.ts): a file upload that keeps its own files is handed the
   * files its fixture lists, once it is defined — the same step the web package's harness runs (`Staging.after`). The
   * size function is set first and answers a size with its item's text (it is left unset where no item has one); then
   * `add()` is called once with one `File` per item, in order: named by the item, as many zero bytes long as its place
   * among the items, so that no two are the same file, with one fixed time of last change and the media type a browser
   * reports for the name's ending. Nothing is sent anywhere.
   */
  async function stageFiles(element: HTMLElement) {
    // (A chat composer that keeps its own files is handed them the same way, by its `addFiles()`; it has no size function.)
    type Upload = HTMLElement & { formatSize: ((bytes: number) => string) | null; add?: (files: File[]) => unknown; addFiles?: (files: File[]) => unknown };
    let items: { name: string; sizeText: string }[] = [];
    try {
      items = JSON.parse(element.dataset.fixtureFiles ?? '[]');
    } catch {
      return;
    }
    if (!items.length) return;
    await customElements.whenDefined(element.localName);
    const upload = element as Upload;
    const add = typeof upload.add === 'function' ? upload.add.bind(upload) : typeof upload.addFiles === 'function' ? upload.addFiles.bind(upload) : null;
    if (!add) return;
    const sizes = items.map((item) => item.sizeText ?? '');
    if (sizes.some(Boolean)) upload.formatSize = (bytes) => sizes[bytes - 1] ?? '';
    // The kind a browser reports of a file its picker hands over, for the endings the fixtures use: a staged file is
    // judged by a media type of `accept` as a chosen one is (the fixture `tiles-own` takes `image/*`).
    const kinds: Record<string, string> = { pdf: 'application/pdf', png: 'image/png', jpeg: 'image/jpeg', jpg: 'image/jpeg', mov: 'video/quicktime', csv: 'text/csv' };
    const kind = (name: string) => kinds[name.slice(name.lastIndexOf('.') + 1).toLowerCase()] ?? '';
    add(items.map((item, index) => new File([new Uint8Array(index + 1)], item.name, { lastModified: 1767225600000, type: kind(item.name) })));
  }
  for (const element of document.querySelectorAll<HTMLElement>('.fixture-element > [data-fixture-files]')) stageFiles(element);
</script>

<style>
  .num {
    display: inline-grid;
    place-items: center;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin-inline-end: 0.25rem;
    border-radius: 50%;
    border: var(--docs-hairline);
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    color: var(--tanrei-sys-color-on-surface-variant);
  }
  /* The row of states and its tags are the Tag group's and the Tag's (NameTag.astro). The site's own: the room above
     the row. */
  .states {
    margin-block-start: 1rem;
  }
  .behavior td:last-child {

---
// Specs tab: everything here is read from specs/<name>.spec.json and the component token group. Every table is Tanrei's
// Table (Table.astro), named by the heading above it; the two name mappings keep their first column, which names the
// row, in view while the platforms scroll under it, and the tokens are at the compact density.
import { componentHref, getSpec, memberOf, platforms, type Forwarded } from '../lib/repo';
import { tokensIn, sharedSetsOf, sourceAlias, formatValue, ns } from '../lib/tokens';
import { contentLang, localeBase, strings } from '../lib/i18n';
import SourceNote from './SourceNote.astro';
import Table from './Table.astro';
import NameTag from './NameTag.astro';
import FixtureGallery from './fixtures/FixtureGallery.astro';
import AnatomyDiagram from './visuals/AnatomyDiagram.astro';
import MeasureDiagram from './visuals/MeasureDiagram.astro';
import { markdownMark } from '../lib/page-markdown.mjs';

interface Props {
  name: string;
}
const spec = getSpec(Astro.props.name);
const t = strings(contentLang(Astro));

// The component's own group first, then every set of tokens it reads that is no component's (the input box):
// each row names its custom property, so the family a token is of is read from its name.
const groups = [spec.tokens, ...sharedSetsOf(spec.name)];
// A component that lives in a layer is read in that layer's system, the one that has its tokens.
const compTokens = groups.flatMap((group) => tokensIn(`${ns}.${group}`, 'light', spec.layer).filter((tk) => tk.type !== 'typography'));
const typographyTokens = groups.flatMap((group) => tokensIn(`${ns}.${group}`, 'light', spec.layer).filter((tk) => tk.type === 'typography'));
// The rows of the tokens' table: the room it holds until it comes near the view (below).
const tokenRows = compTokens.length + typographyTokens.length;
const tokenFile = (group: string) => (spec.layer && group === spec.tokens ? `tokens/systems/${spec.layer}/comp/${group.replace('comp.', '')}.tokens.json` : `tokens/comp/${group.replace('comp.', '')}.tokens.json`);

const showDefault = (v: unknown) => (v === null ? 'null' : typeof v === 'string' ? `"${v}"` : String(v));
const mapped = [
  ...spec.props.map((p) => ({ kind: t.property, name: p.name, key: 'props' as const })),
  ...(spec.events ?? []).map((e) => ({ kind: t.event, name: e.name, key: 'events' as const })),
];
const itemMapped = (kind: NonNullable<typeof spec.items>[number]) => [
  ...kind.props.map((p) => ({ kind: t.property, name: p.name, key: 'props' as const })),
  ...(kind.events ?? []).map((e) => ({ kind: t.event, name: e.name, key: 'events' as const })),
];
// A prop, an event or a slot a composed component takes from a member: the description is the member's
// own, and after it stand the member — its title, linked to its page — and the sentence the composed spec adds.
const base = localeBase(Astro);
const member = (entry: Forwarded) => {
  const name = memberOf(entry);
  return name ? { title: getSpec(name).title, href: componentHref(base, name) } : undefined;
};
const noteHtml = (notes: string | undefined) => (notes ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>');
---

{/* In the page's Markdown, the spec's own Markdown stands in place of everything drawn here (lib/page-markdown.mjs). */}
<Fragment set:html={markdownMark.spec(spec.name)} />
<h3>{t.anatomy}</h3>
{/* The figure numbers the parts over the live component; the table under it is its legend. */}
<AnatomyDiagram name={spec.name} describedBy={`docs-anatomy-${spec.name}`} />
<div id={`docs-anatomy-${spec.name}`}><Table label={t.anatomy}><table class="described" role="table">
  <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">{t.part}</th><th scope="col" role="columnheader">{t.description}</th></tr></thead>
  <tbody role="rowgroup">
    {spec.anatomy.map((part, i) => (
      <tr role="row">
        <td role="cell"><span class="part"><span class="num">{i + 1}</span> <code>{part.id}</code></span>{part.optional && <em class="docs-muted"> · {t.optional}</em>}</td>
        <td role="cell">{part.description}</td>
      </tr>
    ))}
  </tbody>
</table></Table></div>

<MeasureDiagram name={spec.name} headingLevel={3} />

<h3>{t.props}</h3>
<Table label={t.props}><table class="described" role="table">
  <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">{t.property}</th><th scope="col" role="columnheader">{t.type}</th><th scope="col" role="columnheader">{t.default_}</th><th scope="col" role="columnheader">{t.description}</th></tr></thead>
  <tbody role="rowgroup">
    {spec.props.map((prop) => (
      <tr role="row">
        <td role="cell" data-wrap="false"><code>{prop.name}</code></td>
        <td role="cell" data-label={t.type}>
          {prop.values
            ? prop.values.map((v, i) => (<>{i > 0 && ' | '}<code>{v}</code></>))
            : <code>{prop.type}</code>}
        </td>
        <td role="cell" data-wrap="false" data-label={t.default_}><code>{showDefault(prop.default)}</code></td>
        <td role="cell">{prop.description}{member(prop) && <span class="docs-muted from"> — {member(prop)!.href ? <a class="tanrei-link" href={member(prop)!.href}>{member(prop)!.title}</a> : member(prop)!.title}</span>}{prop.note && <> {prop.note}</>}</td>
      </tr>
    ))}
  </tbody>
</table></Table>

{spec.slots && spec.slots.length > 0 && (
  <>
    <h3>{t.slots}</h3>
    <Table label={t.slots}><table class="described" role="table">
      <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">{t.slot}</th><th scope="col" role="columnheader">{t.description}</th></tr></thead>
      <tbody role="rowgroup">
        {spec.slots.map((slot) => (<tr role="row"><td role="cell"><code>{slot.name}</code></td><td role="cell">{slot.description}{member(slot) && <span class="docs-muted from"> — {member(slot)!.href ? <a class="tanrei-link" href={member(slot)!.href}>{member(slot)!.title}</a> : member(slot)!.title}</span>}{slot.note && <> {slot.note}</>}</td></tr>))}
      </tbody>
    </table></Table>
  </>
)}

{spec.events && spec.events.length > 0 && (
  <>
    <h3>{t.events}</h3>
    <Table label={t.events}><table class="described" role="table">
      <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">{t.event}</th><th scope="col" role="columnheader">{t.description}</th></tr></thead>
      <tbody role="rowgroup">
        {spec.events.map((event) => (<tr role="row"><td role="cell"><code>{event.name}</code></td><td role="cell">{event.description}{member(event) && <span class="docs-muted from"> — {member(event)!.href ? <a class="tanrei-link" href={member(event)!.href}>{member(event)!.title}</a> : member(event)!.title}</span>}{event.note && <> {event.note}</>}</td></tr>))}
      </tbody>
    </table></Table>
  </>
)}

{spec.items && spec.items.length > 0 && (
  <>
    <h3>{t.items}</h3>
    <p class="docs-muted">{t.itemsHelp}</p>
    {spec.items.map((kind) => (
      <>
        <h4><code>{kind.name}</code>{kind.container && <em class="docs-muted"> · {t.container}</em>}</h4>
        <p>{kind.summary}</p>
        {kind.props.length > 0 && (
          <Table label={`${kind.name} · ${t.props}`}><table class="described" role="table">
            <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">{t.property}</th><th scope="col" role="columnheader">{t.type}</th><th scope="col" role="columnheader">{t.default_}</th><th scope="col" role="columnheader">{t.description}</th></tr></thead>
            <tbody role="rowgroup">
              {kind.props.map((prop) => (
                <tr role="row">
                  <td role="cell" data-wrap="false"><code>{prop.name}</code></td>
                  <td role="cell" data-label={t.type}>
                    {prop.values
                      ? prop.values.map((v, i) => (<>{i > 0 && ' | '}<code>{v}</code></>))
                      : <code>{prop.type}</code>}
                  </td>
                  <td role="cell" data-wrap="false" data-label={t.default_}><code>{showDefault(prop.default)}</code></td>
                  <td role="cell">{prop.description}</td>
                </tr>
              ))}
            </tbody>
          </table></Table>
        )}
        {kind.slots && kind.slots.length > 0 && (
          <Table label={`${kind.name} · ${t.slots}`}><table class="described" role="table">
            <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">{t.slot}</th><th scope="col" role="columnheader">{t.description}</th></tr></thead>
            <tbody role="rowgroup">
              {kind.slots.map((slot) => (<tr role="row"><td role="cell"><code>{slot.name}</code></td><td role="cell">{slot.description}</td></tr>))}
            </tbody>
          </table></Table>
        )}
        {kind.events && kind.events.length > 0 && (
          <Table label={`${kind.name} · ${t.events}`}><table class="described" role="table">
            <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">{t.event}</th><th scope="col" role="columnheader">{t.description}</th></tr></thead>
            <tbody role="rowgroup">
              {kind.events.map((event) => (<tr role="row"><td role="cell"><code>{event.name}</code></td><td role="cell">{event.description}</td></tr>))}
            </tbody>
          </table></Table>
        )}
        <Table label={`${kind.name} · ${t.mapping}`} rowHeaders stickyFirstColumn><table>
          <thead>
            <tr>
              <th scope="col">{t.specName}</th>
              {platforms.map((p) => <th scope="col">{t.platform[p] ?? p}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="docs-muted">{t.item}</th>
              {platforms.map((p) => <td><code>{spec.platforms[p]?.items?.[kind.name]?.name ?? '—'}</code></td>)}
            </tr>
            {itemMapped(kind).map((m) => (
              <tr>
                <th scope="row" data-wrap="false"><code>{m.name}</code> <span class="docs-muted">· {m.kind}</span></th>
                {platforms.map((p) => <td><code>{spec.platforms[p]?.items?.[kind.name]?.[m.key]?.[m.name] ?? '—'}</code></td>)}
              </tr>
            ))}
            {platforms.some((p) => spec.platforms[p]?.items?.[kind.name]?.notes) && (
              <tr>
                <th scope="row" class="docs-muted">{t.notes}</th>
                {platforms.map((p) => <td class="note" set:html={noteHtml(spec.platforms[p]?.items?.[kind.name]?.notes)} />)}
              </tr>
            )}
          </tbody>
        </table></Table>
      </>
    ))}
  </>
)}

<h3>{t.states}</h3>
{/* The states are Tanrei's Tag group of small outlined tags (NameTag.astro): names, not controls. A space parts two
    tags for the search index. */}
<tanrei-tag-group class="states docs-name-tags not-content" spacing="tags" label={t.states}>
  {spec.states.map((state) => <><NameTag label={state} />{' '}</>)}
</tanrei-tag-group>

<h3>{t.behavior}</h3>
<p class="docs-muted">{t.behaviorHelp}</p>
<Table label={t.behavior}><table class="behavior" role="table">
  <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">{t.id}</th><th scope="col" role="columnheader">{t.requirement}</th></tr></thead>
  <tbody role="rowgroup">
    {spec.behavior.map((b) => (<tr role="row" id={b.id.toLowerCase()}><td role="cell"><code>{b.id}</code></td><td role="cell">{b.text}</td></tr>))}
  </tbody>
</table></Table>

<h3 id="platform-names">{t.mapping}</h3>
<p class="docs-muted">{t.mappingHelp}</p>
<Table label={t.mapping} rowHeaders stickyFirstColumn><table>
  <thead>
    <tr>
      <th scope="col">{t.specName}</th>
      {platforms.map((p) => <th scope="col">{t.platform[p] ?? p}</th>)}
    </tr>
  </thead>
  <tbody>
    <tr>
      <th scope="row" class="docs-muted">{t.component}</th>
      {platforms.map((p) => <td><code>{spec.platforms[p]?.name ?? '—'}</code></td>)}
    </tr>
    {mapped.map((m) => (
      <tr>
        <th scope="row" data-wrap="false"><code>{m.name}</code> <span class="docs-muted">· {m.kind}</span></th>
        {platforms.map((p) => <td><code>{spec.platforms[p]?.[m.key]?.[m.name] ?? '—'}</code></td>)}
      </tr>
    ))}
    {platforms.some((p) => spec.platforms[p]?.notes) && (
      <tr>
        <th scope="row" class="docs-muted">{t.notes}</th>
        {platforms.map((p) => <td class="note" set:html={noteHtml(spec.platforms[p]?.notes)} />)}
      </tr>
    )}
  </tbody>
</table></Table>

<h3>{t.tokens}</h3>
<div class="tokens" style={`--docs-token-rows: ${tokenRows}`}><Table label={t.tokens} size="small"><table>
  {/* No cell of it wraps, its header cells included: every row is one line, the room it holds until it is drawn (below). */}
  <thead><tr><th scope="col" data-wrap="false">{t.token}</th><th scope="col" data-wrap="false">{t.aliases}</th><th scope="col" data-wrap="false">{t.resolvedLight}</th></tr></thead>
  <tbody>
    {[...compTokens, ...typographyTokens].map((tk) => {
      const alias = sourceAlias(tk.name);
      return (
        <tr>
          <td data-wrap="false"><code>{tk.cssVar}</code></td>
          {/* Each row is as few elements as it can be: a component's page holds hundreds of them. */}
          {alias ? <td data-wrap="false"><code>{alias.replace(`${ns}.`, '')}</code></td> : <td class="docs-muted" data-wrap="false">—</td>}
          {/* A value is one line, a color's swatch beside it: a shadow's layers and an easing's four numbers read as the
              one value they are, as a stylesheet writes them, and the column is as wide as its longest value. */}
          <td data-wrap="false">
            {tk.type === 'color' && <tanrei-swatch class="chip" decorative size="small" shape="circle" color={tk.value.hex} />}
            <span class="docs-mono">{formatValue(tk)}</span>
          </td>
        </tr>
      );
    })}
  </tbody>
</table></Table></div>

<h3>{t.fixtures}</h3>
<p class="docs-muted">{t.fixturesHelp}</p>
<FixtureGallery name={spec.name} />
<SourceNote files={[`specs/${spec.name}.spec.json`, ...groups.map(tokenFile), spec.layer ? `design/tokens/${spec.layer}/` : 'design/tokens/']} />
<Fragment set:html={markdownMark.end} />


<style>
  .num {
    display: inline-grid;
    place-items: center;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin-inline-end: 0.25rem;
    border-radius: 50%;
    border: var(--docs-hairline);
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    color: var(--tanrei-sys-color-on-surface-variant);
  }
  /* The row of states and its tags are the Tag group's and the Tag's (NameTag.astro). The site's own: the room above
     the row. */
  .states {
    margin-block-start: 1rem;
  }
  /* A part's number stays with its name; the name breaks after its hyphens and "optional" goes under it, so that on a
     narrow screen the column is no wider than the longest piece of a name, and the description beside it is not left
     a word to a line. (Every other name in these tables stays on one line: `td code` below.) */
  .part {
    white-space: nowrap;
  }
  .part code {
    white-space: pre-wrap;
  }
  /* A column of sentences keeps a readable measure where the table is narrower than its columns (it then scrolls
     sideways, TBL-17), and never more than the box shows beside a narrow first column: on a phone the reader would
     otherwise scroll every line of it. 100cqi is the Table's box (it is a size container). */
  .described td:last-child {
    min-inline-size: min(16rem, 55cqi);
  }
  .behavior td:last-child {
    min-inline-size: min(18rem, 70cqi);
  }
  /* Where the Table's box is narrower than a property's four columns need beside a readable description — a phone, a
     narrow window — each row of a table of sentences stands as one block, as the property tables of other design
     systems' documentation do on a phone: the name on its line, a property's type and default on the next, each after
     its column's name, and the description under them at the box's whole width. Each row would otherwise be as tall
     as its description at its least measure, and scroll sideways with it, while its name, type and default stood in
     an empty band. The query is the Table's own box (it is an inline-size container), not the window: the same table
     in a wider column keeps its columns.
     It is still a table to assistive technology: the elements say their roles (`role="table"`, `row`, `columnheader`,
     `cell`), for an engine that reads a table's semantics from its display would drop them here, and its header row
     is still there, out of sight, naming each cell's column; the column's name drawn before a value is generated text, given no text of its
     own for assistive technology (`/ ""`), which reads the header. The Table's own rules still draw each cell's
     paddings, its text and the line under the row (the row's last cell, its description, keeps its border); only what
     makes it a row of columns is taken away. Not the Table's: its spec keeps a data table's columns and scrolls them
     (TBL-17), and these are the docs' own reference tables, rows of a name and its sentences. */
  @container (inline-size < 40rem) {
    .described,
    .described > tbody,
    .behavior,
    .behavior > tbody {
      display: block;
    }
    .described > thead,
    .behavior > thead {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .described > tbody > tr,
    .behavior > tbody > tr {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      block-size: auto;
    }
    .described > tbody > tr > td,
    .behavior > tbody > tr > td {
      display: block;
      flex: 1 0 100%;
      min-inline-size: 0;
    }
    /* The description is a paragraph at the box's width: a run longer than the whole line (an API's name in a
       requirement, `ViewConfiguration.getScaledMinimumFlingVelocity`) breaks where it must rather than make the row
       scroll sideways — `anywhere`, not `break-word`, so that it does not widen the table either. Nothing shorter than
       the line is broken. */
    .described > tbody > tr > td:last-child,
    .behavior > tbody > tr > td:last-child {
      overflow-wrap: anywhere;
    }
    /* The cells between the first and the last stand on one line where they fit: a property's type and its default. */
    .described > tbody > tr > td:not(:first-child, :last-child) {
      flex: 0 1 auto;
    }
    /* One band of the row's padding above its first line and one under its last, and the line under the row is its
       last cell's: the cells between give theirs up. */
    .described > tbody > tr > td:not(:first-child),
    .behavior > tbody > tr > td:not(:first-child) {
      padding-block-start: var(--tanrei-sys-space-space50);
    }
    .described > tbody > tr > td:not(:last-child),
    .behavior > tbody > tr > td:not(:last-child) {
      padding-block-end: 0;
      border-block-end-width: 0;
    }
    .described > tbody > tr > td[data-label]::before {
      content: attr(data-label);
      content: attr(data-label) / '';
      margin-inline-end: var(--tanrei-sys-space-space100);
      font:
        var(--tanrei-comp-table-header-text-typescale-medium-font-weight) var(--tanrei-comp-table-header-text-typescale-medium-font-size) / var(--tanrei-comp-table-header-text-typescale-medium-line-height)
        var(--tanrei-comp-table-header-text-typescale-medium-font-family);
      letter-spacing: var(--tanrei-comp-table-header-text-typescale-medium-letter-spacing);
      color: var(--tanrei-comp-table-header-text-color);
    }
  }
  .note {
    min-inline-size: 10rem;
    font-size: var(--sl-text-xs);
    color: var(--tanrei-sys-color-on-surface-variant);
  }
  /* A color token's value is Tanrei's Swatch, decorative: the value beside it in text names the color. Its room is
     held before it is defined; without script it is not drawn, and the value still reads. */
  .chip {
    margin-inline-end: 0.375rem;
  }
  .chip:not(:defined) {
    display: inline-block;
    inline-size: var(--tanrei-comp-swatch-container-size-small);
    block-size: var(--tanrei-comp-swatch-container-size-small);
    vertical-align: middle;
    visibility: hidden;
  }
  @media (scripting: none) {
    .chip:not(:defined) {
      display: none;
    }
  }
  td code {
    white-space: nowrap;
  }
  /* The tokens' table is the longest thing on a component's page — hundreds of rows, half of the page's elements, far
     below its head — and it is neither styled nor laid out until it comes near the view: the browser restyled every
     row of it each time a script read the layout as the page loaded. Until then it holds the room of its rows and its
     header row, each one line of the Table's small cell, and that is the room it takes once drawn, at every width and
     in every language: no cell of it wraps (`data-wrap="false"` on every column), so a row is one line whatever its
     column's width, and where its columns need more than the box the Table scrolls them sideways. (A cell its column
     broke — a shadow, an easing, a header in a narrow column — made the table taller than the room it held, by up to
     3000 px, and a browser without scroll anchoring moved what was in view when it was drawn above it.) The room it
     remembers (`auto`) is the room it took once drawn. Its text is still found by the browser's find in page, which
     draws it. The Table reads its sizes again when it is drawn (a size observer), so it is
     a focus stop and a region where it scrolls once it is near. The other tables, whose rows are paragraphs of no
     height known before they are laid out, are drawn with the page.
     The box that skips it is a block of its own around the Table, never the Table: the Table is a size container (its
     caption is 100cqi wide), and WebKit lays out the content of a skipped box that is a size container all the same —
     every layout of the page laid out its rows, and on a page that reads right to left took two and a half times as
     long as one without them. (WebKit still restyles skipped content: that, the rows cost with every restyle of the
     page.) */
  .tokens {
    content-visibility: auto;
    contain-intrinsic-block-size: auto
      calc(
        (var(--docs-token-rows) + 1) *
          (2 * var(--tanrei-comp-table-cell-padding-block-small) + var(--tanrei-comp-table-cell-text-typescale-small-line-height) * var(--tanrei-comp-table-cell-text-typescale-small-font-size))
      );
  }
</style>

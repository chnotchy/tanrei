---
// Specs tab: everything here is read from specs/<name>.spec.json and the component token group. Every table is Tanrei's
// Table (Table.astro), named by the heading above it; the two name mappings keep their first column, which names the
// row, in view while the platforms scroll under it, and the tokens are at the compact density.
import { componentHref, getSpec, memberOf, platforms, type Forwarded } from '../lib/repo';
import { tokensIn, sharedSetsOf, sourceAlias, formatValue, ns } from '../lib/tokens';
import { contentLang, localeBase, strings } from '../lib/i18n';
import SourceNote from './SourceNote.astro';
import Table from './Table.astro';
import NameTag from './NameTag.astro';
import FixtureGallery from './fixtures/FixtureGallery.astro';
import AnatomyDiagram from './visuals/AnatomyDiagram.astro';
import MeasureDiagram from './visuals/MeasureDiagram.astro';
import { markdownMark } from '../lib/page-markdown.mjs';

interface Props {
  name: string;
}
const spec = getSpec(Astro.props.name);
const t = strings(contentLang(Astro));

// The component's own group first, then every set of tokens it reads that is no component's (the input box):
// each row names its custom property, so the family a token is of is read from its name.
const groups = [spec.tokens, ...sharedSetsOf(spec.name)];
// A component that lives in a layer is read in that layer's system, the one that has its tokens.
const compTokens = groups.flatMap((group) => tokensIn(`${ns}.${group}`, 'light', spec.layer).filter((tk) => tk.type !== 'typography'));
const typographyTokens = groups.flatMap((group) => tokensIn(`${ns}.${group}`, 'light', spec.layer).filter((tk) => tk.type === 'typography'));
// The rows of the tokens' table: the room it holds until it comes near the view (below).
const tokenRows = compTokens.length + typographyTokens.length;
const tokenFile = (group: string) => (spec.layer && group === spec.tokens ? `tokens/systems/${spec.layer}/comp/${group.replace('comp.', '')}.tokens.json` : `tokens/comp/${group.replace('comp.', '')}.tokens.json`);

const showDefault = (v: unknown) => (v === null ? 'null' : typeof v === 'string' ? `"${v}"` : String(v));
const mapped = [
  ...spec.props.map((p) => ({ kind: t.property, name: p.name, key: 'props' as const })),
  ...(spec.events ?? []).map((e) => ({ kind: t.event, name: e.name, key: 'events' as const })),
];
const itemMapped = (kind: NonNullable<typeof spec.items>[number]) => [
  ...kind.props.map((p) => ({ kind: t.property, name: p.name, key: 'props' as const })),
  ...(kind.events ?? []).map((e) => ({ kind: t.event, name: e.name, key: 'events' as const })),
];
// A prop, an event or a slot a composed component takes from a member: the description is the member's
// own, and after it stand the member — its title, linked to its page — and the sentence the composed spec adds.
const base = localeBase(Astro);
const member = (entry: Forwarded) => {
  const name = memberOf(entry);
  return name ? { title: getSpec(name).title, href: componentHref(base, name) } : undefined;
};
const noteHtml = (notes: string | undefined) => (notes ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>');
---

{/* In the page's Markdown, the spec's own Markdown stands in place of everything drawn here (lib/page-markdown.mjs). */}
<Fragment set:html={markdownMark.spec(spec.name)} />
<h3>{t.anatomy}</h3>
{/* The figure numbers the parts over the live component; the table under it is its legend. */}
<AnatomyDiagram name={spec.name} describedBy={`docs-anatomy-${spec.name}`} />
<div id={`docs-anatomy-${spec.name}`}><Table label={t.anatomy}><table>
  <thead><tr><th scope="col">{t.part}</th><th scope="col">{t.description}</th></tr></thead>
  <tbody>
    {spec.anatomy.map((part, i) => (
      <tr>
        <td data-wrap="false"><span class="num">{i + 1}</span> <code>{part.id}</code>{part.optional && <em class="docs-muted"> · {t.optional}</em>}</td>
        <td>{part.description}</td>
      </tr>
    ))}
  </tbody>
</table></Table></div>

<MeasureDiagram name={spec.name} headingLevel={3} />

<h3>{t.props}</h3>
<Table label={t.props}><table>
  <thead><tr><th scope="col">{t.property}</th><th scope="col">{t.type}</th><th scope="col">{t.default_}</th><th scope="col">{t.description}</th></tr></thead>
  <tbody>
    {spec.props.map((prop) => (
      <tr>
        <td data-wrap="false"><code>{prop.name}</code></td>
        <td>
          {prop.values
            ? prop.values.map((v, i) => (<>{i > 0 && ' | '}<code>{v}</code></>))
            : <code>{prop.type}</code>}
        </td>
        <td data-wrap="false"><code>{showDefault(prop.default)}</code></td>
        <td>{prop.description}{member(prop) && <span class="docs-muted from"> — {member(prop)!.href ? <a class="tanrei-link" href={member(prop)!.href}>{member(prop)!.title}</a> : member(prop)!.title}</span>}{prop.note && <> {prop.note}</>}</td>
      </tr>
    ))}
  </tbody>
</table></Table>

{spec.slots && spec.slots.length > 0 && (
  <>
    <h3>{t.slots}</h3>
    <Table label={t.slots}><table>
      <thead><tr><th scope="col">{t.slot}</th><th scope="col">{t.description}</th></tr></thead>
      <tbody>
        {spec.slots.map((slot) => (<tr><td><code>{slot.name}</code></td><td>{slot.description}{member(slot) && <span class="docs-muted from"> — {member(slot)!.href ? <a class="tanrei-link" href={member(slot)!.href}>{member(slot)!.title}</a> : member(slot)!.title}</span>}{slot.note && <> {slot.note}</>}</td></tr>))}
      </tbody>
    </table></Table>
  </>
)}

{spec.events && spec.events.length > 0 && (
  <>
    <h3>{t.events}</h3>
    <Table label={t.events}><table>
      <thead><tr><th scope="col">{t.event}</th><th scope="col">{t.description}</th></tr></thead>
      <tbody>
        {spec.events.map((event) => (<tr><td><code>{event.name}</code></td><td>{event.description}{member(event) && <span class="docs-muted from"> — {member(event)!.href ? <a class="tanrei-link" href={member(event)!.href}>{member(event)!.title}</a> : member(event)!.title}</span>}{event.note && <> {event.note}</>}</td></tr>))}
      </tbody>
    </table></Table>
  </>
)}

{spec.items && spec.items.length > 0 && (
  <>
    <h3>{t.items}</h3>
    <p class="docs-muted">{t.itemsHelp}</p>
    {spec.items.map((kind) => (
      <>
        <h4><code>{kind.name}</code>{kind.container && <em class="docs-muted"> · {t.container}</em>}</h4>
        <p>{kind.summary}</p>
        {kind.props.length > 0 && (
          <Table label={`${kind.name} · ${t.props}`}><table>
            <thead><tr><th scope="col">{t.property}</th><th scope="col">{t.type}</th><th scope="col">{t.default_}</th><th scope="col">{t.description}</th></tr></thead>
            <tbody>
              {kind.props.map((prop) => (
                <tr>
                  <td data-wrap="false"><code>{prop.name}</code></td>
                  <td>
                    {prop.values
                      ? prop.values.map((v, i) => (<>{i > 0 && ' | '}<code>{v}</code></>))
                      : <code>{prop.type}</code>}
                  </td>
                  <td data-wrap="false"><code>{showDefault(prop.default)}</code></td>
                  <td>{prop.description}</td>
                </tr>
              ))}
            </tbody>
          </table></Table>
        )}
        {kind.slots && kind.slots.length > 0 && (
          <Table label={`${kind.name} · ${t.slots}`}><table>
            <thead><tr><th scope="col">{t.slot}</th><th scope="col">{t.description}</th></tr></thead>
            <tbody>
              {kind.slots.map((slot) => (<tr><td><code>{slot.name}</code></td><td>{slot.description}</td></tr>))}
            </tbody>
          </table></Table>
        )}
        {kind.events && kind.events.length > 0 && (
          <Table label={`${kind.name} · ${t.events}`}><table>
            <thead><tr><th scope="col">{t.event}</th><th scope="col">{t.description}</th></tr></thead>
            <tbody>
              {kind.events.map((event) => (<tr><td><code>{event.name}</code></td><td>{event.description}</td></tr>))}
            </tbody>
          </table></Table>
        )}
        <Table label={`${kind.name} · ${t.mapping}`} rowHeaders stickyFirstColumn><table>
          <thead>
            <tr>
              <th scope="col">{t.specName}</th>
              {platforms.map((p) => <th scope="col">{t.platform[p] ?? p}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="docs-muted">{t.item}</th>
              {platforms.map((p) => <td><code>{spec.platforms[p]?.items?.[kind.name]?.name ?? '—'}</code></td>)}
            </tr>
            {itemMapped(kind).map((m) => (
              <tr>
                <th scope="row" data-wrap="false"><code>{m.name}</code> <span class="docs-muted">· {m.kind}</span></th>
                {platforms.map((p) => <td><code>{spec.platforms[p]?.items?.[kind.name]?.[m.key]?.[m.name] ?? '—'}</code></td>)}
              </tr>
            ))}
            {platforms.some((p) => spec.platforms[p]?.items?.[kind.name]?.notes) && (
              <tr>
                <th scope="row" class="docs-muted">{t.notes}</th>
                {platforms.map((p) => <td class="note" set:html={noteHtml(spec.platforms[p]?.items?.[kind.name]?.notes)} />)}
              </tr>
            )}
          </tbody>
        </table></Table>
      </>
    ))}
  </>
)}

<h3>{t.states}</h3>
{/* The states are Tanrei's Tag group of small outlined tags (NameTag.astro): names, not controls. A space parts two
    tags for the search index. */}
<tanrei-tag-group class="states docs-name-tags not-content" spacing="tags" label={t.states}>
  {spec.states.map((state) => <><NameTag label={state} />{' '}</>)}
</tanrei-tag-group>

<h3>{t.behavior}</h3>
<p class="docs-muted">{t.behaviorHelp}</p>
<Table label={t.behavior}><table class="behavior">
  <thead><tr><th scope="col">{t.id}</th><th scope="col">{t.requirement}</th></tr></thead>
  <tbody>
    {spec.behavior.map((b) => (<tr id={b.id.toLowerCase()}><td><code>{b.id}</code></td><td>{b.text}</td></tr>))}
  </tbody>
</table></Table>

<h3 id="platform-names">{t.mapping}</h3>
<p class="docs-muted">{t.mappingHelp}</p>
<Table label={t.mapping} rowHeaders stickyFirstColumn><table>
  <thead>
    <tr>
      <th scope="col">{t.specName}</th>
      {platforms.map((p) => <th scope="col">{t.platform[p] ?? p}</th>)}
    </tr>
  </thead>
  <tbody>
    <tr>
      <th scope="row" class="docs-muted">{t.component}</th>
      {platforms.map((p) => <td><code>{spec.platforms[p]?.name ?? '—'}</code></td>)}
    </tr>
    {mapped.map((m) => (
      <tr>
        <th scope="row" data-wrap="false"><code>{m.name}</code> <span class="docs-muted">· {m.kind}</span></th>
        {platforms.map((p) => <td><code>{spec.platforms[p]?.[m.key]?.[m.name] ?? '—'}</code></td>)}
      </tr>
    ))}
    {platforms.some((p) => spec.platforms[p]?.notes) && (
      <tr>
        <th scope="row" class="docs-muted">{t.notes}</th>
        {platforms.map((p) => <td class="note" set:html={noteHtml(spec.platforms[p]?.notes)} />)}
      </tr>
    )}
  </tbody>
</table></Table>

<h3>{t.tokens}</h3>
<Table label={t.tokens} density="compact" class="tokens" style={`--docs-token-rows: ${tokenRows}`}><table>
  <thead><tr><th scope="col">{t.token}</th><th scope="col">{t.aliases}</th><th scope="col">{t.resolvedLight}</th></tr></thead>
  <tbody>
    {[...compTokens, ...typographyTokens].map((tk) => {
      const alias = sourceAlias(tk.name);
      return (
        <tr>
          <td data-wrap="false"><code>{tk.cssVar}</code></td>
          {/* Each row is as few elements as it can be: a component's page holds hundreds of them. */}
          {alias ? <td><code>{alias.replace(`${ns}.`, '')}</code></td> : <td class="docs-muted">—</td>}
          {/* A color's swatch and its value stand on one line: the value is not broken under its swatch. */}
          <td data-wrap={tk.type === 'color' ? 'false' : undefined}>
            {tk.type === 'color' && <tanrei-swatch class="chip" decorative size="small" shape="circle" color={tk.value.hex} />}
            <span class="docs-mono">{formatValue(tk)}</span>
          </td>
        </tr>
      );
    })}
  </tbody>
</table></Table>

<h3>{t.fixtures}</h3>
<p class="docs-muted">{t.fixturesHelp}</p>
<FixtureGallery name={spec.name} />
<SourceNote files={[`specs/${spec.name}.spec.json`, ...groups.map(tokenFile), spec.layer ? `design/tokens/${spec.layer}/` : 'design/tokens/']} />
<Fragment set:html={markdownMark.end} />


<style>
  .num {
    display: inline-grid;
    place-items: center;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin-inline-end: 0.25rem;
    border-radius: 50%;
    border: var(--docs-hairline);
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    color: var(--tanrei-sys-color-on-surface-variant);
  }
  /* The row of states and its tags are the Tag group's and the Tag's (NameTag.astro). The site's own: the room above
     the row. */
  .states {
    margin-block-start: 1rem;
  }
  .behavior td:last-child {
    min-inline-size: 18rem;
  }
  .note {
    min-inline-size: 10rem;
    font-size: var(--sl-text-xs);
    color: var(--tanrei-sys-color-on-surface-variant);
  }
  /* A color token's value is Tanrei's Swatch, decorative: the value beside it in text names the color. Its room is
     held before it is defined; without script it is not drawn, and the value still reads. */
  .chip {
    margin-inline-end: 0.375rem;
  }
  .chip:not(:defined) {
    display: inline-block;
    inline-size: var(--tanrei-comp-swatch-container-size-small);
    block-size: var(--tanrei-comp-swatch-container-size-small);
    vertical-align: middle;
    visibility: hidden;
  }
  @media (scripting: none) {
    .chip:not(:defined) {
      display: none;
    }
  }
  td code {
    white-space: nowrap;
  }
  /* The tokens' table is the longest thing on a component's page — hundreds of rows, half of the page's elements, far
     below its head — and it is neither styled nor laid out until it comes near the view: the browser restyled every
     row of it each time a script read the layout as the page loaded. Until then it holds the room of its rows and its
     header row, each one line of the Table's compact cell (every row of it is one line, but a long value the column
     wraps, a shadow); the room it remembers (`auto`) is the room it took once drawn. Its text is still found by the
     browser's find in page, which draws it. The Table reads its sizes again when it is drawn (a size observer), so it is
     a focus stop and a region where it scrolls once it is near. The other tables, whose rows are paragraphs of no
     height known before they are laid out, are drawn with the page. */
  .tokens {
    content-visibility: auto;
    contain-intrinsic-block-size: auto
      calc(
        (var(--docs-token-rows) + 1) *
          (2 * var(--tanrei-comp-table-cell-padding-block-compact) + var(--tanrei-comp-table-cell-text-typescale-compact-line-height) * var(--tanrei-comp-table-cell-text-typescale-compact-font-size))
      );
  }
</style>

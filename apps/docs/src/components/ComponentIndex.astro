---
// All inventory components grouped by category, each category a Tanrei list whose items are links (`<tanrei-list-item
// href>`); a link only where a page documents the component (`componentHref`) — an entry without one is a
// static item that says "Planned" at its end. Each item says its platforms and its level. The item's content is the
// page's own (the list draws only the box around it): the title, the line of platforms and level, and the word at the end.
//
// The list follows the specs' `listing` as the sidebar does: a
// component shown on request is marked — the word at the end of its row — and drawn only to a reader who asked for
// everything with the switch above the list (ListingSwitch.astro), which is the sidebar's switch too. A category whose
// components are all shown on request is marked with them, so that no heading stands over nothing. Without script
// every item is drawn.
import { statusComponents, platforms, componentHref, isImplemented, levelRole, listings } from '../lib/repo';
import { contentLang, localeBase, strings } from '../lib/i18n';
import { categoriesOf, groupOf, isOnRequest, ON_REQUEST_ATTR } from '../lib/listing.mjs';
import ListingSwitch from './ListingSwitch.astro';
import SourceNote from './SourceNote.astro';

interface Props {
  /**
   * The level of the block's headings, from where the page places it: 2 where the block stands directly under the
   * page's title, one more than the heading it stands under otherwise. A page says it; the block does not guess
   * (a heading that skips a level is a broken outline to assistive technology).
   */
  headingLevel: 2 | 3 | 4;
}
const Heading = `h${Astro.props.headingLevel}` as 'h2';
const lang = contentLang(Astro);
const t = strings(lang);
const base = localeBase(Astro);
// The categories, then a group for each layer that holds components of its own (the FAB menu lives in m3-like).
const categories = categoriesOf(statusComponents);
/** The attribute of a row, or of a category, drawn only to a reader who asked for everything. */
const marked = (onRequest: boolean) => (onRequest ? { [ON_REQUEST_ATTR]: '' } : {});
---

<div class="not-content index">
  <ListingSwitch lang={lang} />
  {categories.map((category) => (
    <section {...marked(statusComponents.filter((c) => groupOf(c) === category).every((c) => isOnRequest(c, listings)))}>
      <Heading class="docs-eyebrow">{t.category[category] ?? category}</Heading>
      <tanrei-list class="docs-index-list">
        {statusComponents.filter((c) => groupOf(c) === category).map((c) => {
          const shipped = platforms.filter((p) => isImplemented(c.platforms[p])).length;
          const role = levelRole(c.level);
          const meta = `${shipped}/${platforms.length} · ${(role && t.level[role]) ?? c.level}`;
          const href = componentHref(base, c.name);
          const onRequest = isOnRequest(c, listings);
          // What the end of the row says: that nothing documents it yet, or that it is shown on request.
          const end = href ? (onRequest ? t.listing.advanced : undefined) : t.status.planned;
          // The content of the item: the title over the line of platforms and level, and the word at the end. The
          // item is the link (its own anchor, drawn by the list) or, without a page, a static item; the spaces between
          // the parts, and after each item, are for the search index, which reads words, not one run.
          return (
            <>
              <tanrei-list-item href={href} {...marked(onRequest)}>
                <span class="entry">
                  <span class="text">
                    <span class="title">{c.title}</span>{' '}
                    <span class="meta">{meta}</span>
                  </span>
                  {end && <>{' '}<span class="meta end">{end}</span></>}
                </span>
              </tanrei-list-item>{' '}
            </>
          );
        })}
      </tanrei-list>
    </section>
  ))}
  <SourceNote files={['docs/status/status.json', 'specs/inventory.json']} />
</div>

<script>
  // The list and its items alone — not the whole package.
  import '@tanrei/web/components/list';
</script>

<style>
  .index {
    display: grid;
    gap: 2rem;
    margin-top: 1.5rem;
  }
  /* A category's heading, at whatever level the page gave the block. */
  section > :global(.docs-eyebrow) {
    margin: 0 0 0.75rem;
  }
  /* The items run down a column and then into the next one, so the arrow keys follow the reading order. */
  .docs-index-list {
    display: block;
    columns: 3 13rem;
    column-gap: var(--tanrei-sys-space-space200);
  }
  tanrei-list-item {
    break-inside: avoid;
  }

  /* An item's content: the title over the meta line, and the word at the end. A planned entry is a static item, which
     draws no box: it takes the padding a link item has, so that the column lines up, and the quiet color. Until the
     elements are defined the same content is drawn as plain blocks in the same room, so nothing moves. */
  .entry {
    display: flex;
    align-items: center;
    gap: var(--tanrei-comp-list-container-gap);
  }
  .text {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-inline-size: 0;
  }
  tanrei-list-item:not([href]) .entry,
  tanrei-list-item:not(:defined) .entry {
    box-sizing: border-box;
    min-block-size: var(--tanrei-comp-list-container-height);
    padding-block: var(--tanrei-comp-list-container-padding-block);
    padding-inline: var(--tanrei-comp-list-container-padding-inline-start) var(--tanrei-comp-list-container-padding-inline-end);
  }
  tanrei-list-item:not(:defined) {
    display: block;
  }
  tanrei-list-item:not([href]) {
    color: var(--tanrei-sys-color-on-surface-variant);
  }
  .title {
    font: var(--tanrei-sys-typescale-body-font);
    letter-spacing: var(--tanrei-sys-typescale-body-letter-spacing);
  }
  .meta {
    font: var(--tanrei-sys-typescale-body-small-font);
    letter-spacing: var(--tanrei-sys-typescale-body-small-letter-spacing);
    color: var(--tanrei-sys-color-on-surface-variant);
  }
  .end {
    flex: none;
  }
</style>

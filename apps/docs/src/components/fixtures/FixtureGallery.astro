---
// The Specs tab's fixtures: a gallery of stages, one for each fixture of the spec (lib/fixture-gallery.ts says which
// stage each takes). Every stage draws the fixture as the web package's own document of the component's fixtures
// draws it — the document its tests take each baseline from (lib/fixture-documents.ts) — and the site has no renderer
// of its own. Each stage is the docs' one frame (components/visuals/Example.astro): the fixture's id as its title, its
// actions in its header — the stage's scheme and, as every frame's, the fixture's code as a product writes it, its
// copy and the stage's direction — what the fixture draws on its stage, and the props that make it as the caption. The stages stand in groups by the first axis of the spec that
// tells its fixtures apart (`variant`, else `size`, …).
//
// The stages stand one to a row, each as wide as the column, in one column — as a specification's figures stand one
// under another, and as a reader scrolls them. A fixture drawn in the page is the document's stage, with the
// component's staging scoped to it, at its own size in the middle of the stage; one that is as wide as its layout (the
// staging gives it a width) has a handle on its end edge that makes it narrower or wider. A presented fixture, and a
// whole page's frame, is drawn alone in a window of its own: an `iframe` of the fixture's document
// (pages/fixtures/[component].astro), loaded when it comes near the view, in a box that holds the window's size before
// anything is loaded (scaled down where the column is narrower). That document is only the window's: no action of a
// stage, and no link of the page, sends the reader to it.
//
// The fixture ids and props are the page's words and are read by the search; what a stage draws, and its actions, are
// not (`data-pagefind-ignore`, as every frame's stage).
import { getSpec } from '../../lib/repo';
import { fixtureDocument } from '../../lib/fixture-documents';
import { STAGE_SCOPE, galleryOf, fixtureWindowHref, stagesScript, stagingStyle, stepScript } from '../../lib/fixture-gallery';
import { contentLang, strings } from '../../lib/i18n';
import ResizeHandle from './ResizeHandle.astro';
import Example from '../visuals/Example.astro';

interface Props {
  name: string;
}
const spec = getSpec(Astro.props.name);
const t = strings(contentLang(Astro));
const document = fixtureDocument(spec.name);
const groups = galleryOf(spec);
const inPage = groups.some((group) => group.stages.some((stage) => stage.drawn && stage.kind === 'inline'));
const named = (template: string, values: Record<string, string | number>) => template.replace(/\{(\w+)\}/g, (place, key: string) => (key in values ? String(values[key]) : place));
const scope = { [STAGE_SCOPE]: '' };
// A component that lives in a layer is drawn under that layer's system, as its tests draw it: the stages are scoped to
// it, and its opt-in stylesheet is loaded.
const stylesheets = import.meta.glob<string>('../../../../../packages/web/src/generated/systems/*.css', { eager: true, query: '?url', import: 'default' });
const system = spec.layer && spec.layer !== 'core' ? spec.layer : undefined;
const systemSheet = system ? Object.entries(stylesheets).find(([file]) => file.endsWith(`/${system}.css`))?.[1] : undefined;
if (system && !systemSheet) throw new Error(`FixtureGallery: no generated stylesheet for the system "${system}"`);
---

{systemSheet && <link rel="stylesheet" href={systemSheet} />}

<div class="docs-fixture-gallery not-content" data-fixture-gallery data-component={spec.name} data-fixture-tag={spec.platforms.web?.name} data-fixture-step={inPage && document?.step ? '' : undefined}>
  {inPage && document && <Fragment set:html={stagingStyle(document.staging)} />}
  {inPage && <Fragment set:html={stagesScript(groups)} />}
  {inPage && document?.step && <Fragment set:html={stepScript(spec.name, document.step)} />}
  {groups.map((group) => (
    <section class="docs-fixture-group">
      {group.axis && (
        <h4 class="docs-fixture-axis"><code>{group.axis.name}: {group.axis.value}</code>{' '}<span class="docs-muted docs-fixture-count">({group.stages.length})</span></h4>
      )}
      <div class="docs-fixture-stages">
        {group.stages.map((stage) => {
          const stageId = `docs-stage-${spec.name}-${stage.id}`;
          const sized = stage.kind === 'window' && stage.window;
          return (
            <>
              <Example
                label={stage.id}
                titleCode
                class="docs-stage"
                pattern="none"
                system={system}
                code={stage.drawn}
                source={stage.markup}
                resize={false}
                actions={stage.drawn ? (stage.kind === 'window' ? 2 : 1) : 0}
                stageClass="docs-stage-box"
                stageAttributes={{ id: stageId }}
                data-stage={stage.kind}
                data-fixture-id={stage.id}
                data-drawn={stage.drawn ? '' : undefined}
              >
                {stage.drawn && (
                  <Fragment slot="actions">
                    <tanrei-button class="docs-example-action" variant="text" size="small" toggle label={t.stages.dark} data-stage-theme><span slot="icon" data-pagefind-ignore>dark_mode</span></tanrei-button>
                    {stage.kind === 'window' && (
                      <tanrei-button class="docs-example-action" variant="text" size="small" label={named(t.stages.redraw, { id: stage.id })} data-stage-redraw><span slot="icon" data-pagefind-ignore>refresh</span></tanrei-button>
                    )}
                  </Fragment>
                )}
                {!stage.drawn ? (
                  <p class="docs-muted docs-stage-none">{t.notDefinedYet}</p>
                ) : sized ? (
                  <div class="docs-stage-canvas docs-window" style={`--docs-window-width: ${sized.width}; --docs-window-height: ${sized.height}`} data-fit={stage.presented ? undefined : ''}>
                    <iframe
                      class="docs-window-frame"
                      src={fixtureWindowHref(spec.name, stage.id)}
                      loading="lazy"
                      inert
                      width={sized.width}
                      height={sized.height}
                      title={named(t.stages.frame, { id: stage.id })}
                    />
                    <ResizeHandle label={named(t.stages.width, { id: stage.id })} controls={stageId} />
                  </div>
                ) : (
                  /* The document's stage is drawn in this canvas, from the gallery's data, when the stage comes near
                     the view (lib/fixture-stages.ts); until then the canvas holds the room its baseline shows. Its
                     handle is kept where the staging gives the fixture a layout's width, and taken away elsewhere. */
                  <div
                    class="docs-stage-canvas"
                    {...scope}
                    data-pending
                    style={stage.reserve ? `--docs-stage-reserve-inline: ${stage.reserve.width}px; --docs-stage-reserve-block: ${stage.reserve.height}px` : undefined}
                  >
                    <ResizeHandle label={named(t.stages.width, { id: stage.id })} controls={stageId} />
                  </div>
                )}
                <Fragment slot="caption">
                  {stage.facts.map((fact) => (<><code>{fact}</code>{' '}</>))}
                  {stage.holds.items > 0 && <><code>items: {stage.holds.items}</code>{' '}</>}
                  {stage.holds.slots.length > 0 && <><code>slots: {stage.holds.slots.join(', ')}</code>{' '}</>}
                  {!stage.facts.length && !stage.holds.items && !stage.holds.slots.length && <><code>{'{}'}</code>{' '}</>}
                  {sized && <span class="docs-muted docs-stage-window">{named(t.stages.window, { width: sized.width, height: sized.height })}</span>}
                </Fragment>
              </Example>{' '}
            </>
          );
        })}
      </div>
    </section>
  ))}
</div>

<script>
  import '../../lib/register-web';
  import '../../lib/fixture-stages';
</script>

<style>
  .docs-fixture-gallery {
    display: grid;
    gap: var(--tanrei-sys-space-space300);
    margin-block-start: var(--tanrei-sys-space-space200);
  }
  .docs-fixture-axis {
    margin: 0 0 var(--tanrei-sys-space-space150);
  }
  /* The stages of a group: one column, one stage to a row, each as wide as the column. A row of stages side by side
     would set a small fixture beside an unrelated one and let a wide one push the next onto a row of its own: one under
     another, every stage starts at the same edge, and the next is always below. */
  .docs-fixture-stages {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--tanrei-sys-space-space200);
  }
  /* A stage: the column's width, whatever it draws. Every stage of the page is laid out with the page, as a product's
     screen is: a stage that is not laid out while it is away from the view (`content-visibility: auto`) has no size
     then, and a component that measures its place once — the description list choosing between its terms beside
     their values and above them — keeps the choice it made in no room. */
  .docs-fixture-stages > :global(.docs-stage) {
    display: block;
    min-inline-size: 0;
  }
  /* The id breaks where it must, so that the header never makes a stage wider than what it draws. */
  .docs-fixture-stages > :global(.docs-stage) :global([data-part='title'] code) {
    overflow-wrap: anywhere;
  }
  .docs-fixture-count {
    font-weight: normal;
  }
  /* The props wrap under the stage and do not widen it. */
  .docs-fixture-stages > :global(.docs-stage) :global(.docs-example-caption) {
    contain: inline-size;
  }
  .docs-fixture-stages > :global(.docs-stage) :global(.docs-example-caption) code {
    overflow-wrap: anywhere;
  }
  .docs-stage-window {
    display: block;
  }
  /* The stage: what is drawn stays inside it, clipped to it. It is clipped by its overflow and not by containment: a
     box that contains layout or paint is the box that the fixture's fixed parts are placed against, and a surface
     drawn in place (an open list placed against the window) would then stand where no product's page draws it. What a
     fixture places in the top layer or against the window is drawn in a window of its own instead. */
  .docs-fixture-stages :global(.docs-stage-box) {
    display: grid;
    /* One column as wide as the stage, whatever the fixture asks for: a fixture wider than the column is made narrower
       (a layout's width, a window), never let out of it. */
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    min-block-size: 6rem;
    overflow: clip;
  }
  /* A stage keeps the scheme it is given (lib/fixture-stages.ts): its surface and every token below it. */
  .docs-fixture-stages :global(.docs-stage-box[data-tanrei-theme]) {
    background: var(--tanrei-sys-color-surface);
    color: var(--tanrei-sys-color-on-surface);
  }
  .docs-stage-canvas {
    position: relative;
    box-sizing: border-box;
    max-inline-size: 100%;
  }
  /* A fixture drawn in the page inherits what the web package's document gives its stages, and not the page's text:
     that document sets no text style of its own, so a stage stands in the initial one, as each baseline was taken —
     a line of text the fixture does not style is as tall here as there. */
  .docs-stage-canvas[data-fixture-scope] {
    font: initial;
    letter-spacing: initial;
    word-spacing: initial;
    text-align: initial;
    text-indent: initial;
    text-transform: initial;
    white-space: initial;
    overflow-wrap: initial;
    word-break: initial;
    hyphens: initial;
    color: CanvasText;
  }
  /* The document's stage is its baseline's picture, and the canvas is its box: a margin the staging gives a stage to
     keep the next one clear in the document (a closed FAB menu's 32 below) has no next one here. */
  .docs-stage-canvas[data-fixture-scope] > :global(.stage) {
    margin: 0;
  }
  /* A fixture is drawn when its stage comes near the view (lib/fixture-stages.ts); until then its canvas holds the
     room its baseline shows, so that nothing moves when it is drawn. */
  .docs-stage-canvas[data-pending] {
    min-inline-size: min(100%, var(--docs-stage-reserve-inline, 0px));
    min-block-size: var(--docs-stage-reserve-block, 0px);
  }
  /* A window: as wide as the window it stands for and never wider than the column, as tall as that width keeps its
     proportions — held before the frame loads, so nothing moves when it does. The frame is drawn at the window's size
     and scaled to the box (lib/fixture-stages.ts). */
  .docs-window {
    inline-size: calc(var(--docs-window-width) * 1px);
    max-inline-size: 100%;
    aspect-ratio: var(--docs-window-width) / var(--docs-window-height);
    outline: var(--tanrei-sys-border-hairline) solid var(--tanrei-sys-color-outline-variant);
  }
  .docs-window-frame {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: calc(var(--docs-window-width) * 1px);
    block-size: calc(var(--docs-window-height) * 1px);
    border: 0;
    transform-origin: 0 0;
    transform: scale(var(--docs-window-scale, 1));
    background: var(--tanrei-sys-color-surface);
  }
  .docs-window-frame:dir(rtl) {
    transform-origin: 100% 0;
  }
  .docs-stage-none {
    margin: 0;
    max-inline-size: 16rem;
    white-space: normal;
  }
  /* What a fixture draws before its element is defined is hidden, in the room it takes (as the table's cells were). */
  .docs-fixture-stages :global(.docs-stage-box :not(:defined)) {
    visibility: hidden;
  }
</style>

---
// The product of the reordering demos (the List page, the File item page). A reorderable list changes nothing itself:
// it fires `move` and draws the order the product then gives. On a documentation page the page is the product, so this
// is its answer — for every `<tanrei-list data-demo-product>` — and the removal behind every `[data-demo-remove]`
// button and every file item's remove action in one. It is what the page's own code sample shows a product writing.
---

<script>
  document.addEventListener('move', (event) => {
    const list = event.target instanceof Element ? event.target.closest('tanrei-list[data-demo-product]') : null;
    if (!list || event.target !== list) return;
    const { from, to } = (event as CustomEvent<{ from: number; to: number }>).detail;
    const items = [...list.children];
    list.insertBefore(items[from], items[to > from ? to + 1 : to] ?? null);
  });
  const remove = (from: EventTarget | null) => {
    const item = from instanceof Element ? from.closest('tanrei-list-item') : null;
    if (item?.closest('tanrei-list[data-demo-product]')) item.remove();
  };
  document.addEventListener('click', (event) => {
    const button = event.target instanceof Element ? event.target.closest('[data-demo-remove]') : null;
    if (button) remove(button);
  });
  // A file item's own remove action fires `remove` on the file item.
  document.addEventListener('remove', (event) => {
    if (event.target instanceof Element && event.target.localName === 'tanrei-file-item') remove(event.target);
  });
</script>

---
// Accessibility tab: role, keyboard table, labeling, notes — from the spec's `accessibility` block. The facts are a
// description list; the keyboard table is the keyboard map (visuals/KeyboardMap.astro): the spec's rows in a Tanrei
// Table, named by the heading above it, their keys drawn as caps by the Keyboard shortcut and read in the page's
// language.
import { getSpec } from '../lib/repo';
import { tokensIn, dimension, ns } from '../lib/tokens';
import { contentLang, strings } from '../lib/i18n';
import SourceNote from './SourceNote.astro';
import KeyboardMap from './visuals/KeyboardMap.astro';
import { markdownMark } from '../lib/page-markdown.mjs';

interface Props {
  name: string;
}
const spec = getSpec(Astro.props.name);
const a11y = spec.accessibility;
const t = strings(contentLang(Astro));
const targets = tokensIn(`${ns}.sys.target`);
---

{/* The page's Markdown leaves this out: the spec's Markdown, in the Specs section, holds it (lib/page-markdown.mjs). */}
<Fragment set:html={markdownMark.skip} />
<tanrei-description-list>
  <dl>
    <div><dt>{t.role}</dt><dd><code class="tanrei-code">{a11y.role}</code></dd></div>
    <div><dt>{t.labeling}</dt><dd>{a11y.labeling}</dd></div>
    {a11y.minimumTarget && (
      <div>
        <dt>{t.minimumTarget}</dt>
        <dd>
          {t.minimumTargetText}{' '}
          <span class="docs-mono">{targets.map((tk) => `${tk.path.at(-1)} ${dimension(tk.value)}`).join(' · ')}</span>
        </dd>
      </div>
    )}
  </dl>
</tanrei-description-list>

<h3>{t.keyboard}</h3>
<KeyboardMap name={spec.name} />

{a11y.notes && a11y.notes.length > 0 && (
  <>
    <h3>{t.notes}</h3>
    <ul>{a11y.notes.map((note) => <li>{note}</li>)}</ul>
  </>
)}
<SourceNote files={[`specs/${spec.name}.spec.json`, 'tokens/sys/measure.tokens.json']} />
<Fragment set:html={markdownMark.end} />

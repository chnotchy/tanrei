---
// "All components": a control of the lists of components (the other is the choice of design system,
// SystemSelect.astro), Tanrei's Switch. Off — a reader's first visit — the sidebar and the index show the components
// every list shows; on, also the ones a spec marks to be shown on request (`listing`), each in its place and marked.
// Every switch of a page says the same, and the choice is the reader's: kept in the origin's storage under the key the
// head's script reads before the first paint (lib/listing.mjs, `listingBootstrap`).
//
// What is not shown is taken out of the document, not only out of sight: a list counts its items and moves focus
// among them, and must count what the reader sees (lib/list-filter.ts holds the rows, for both controls). The rule
// that hides a marked row before the script runs is the stylesheet's below.
//
// Without script nothing is hidden and nothing could be switched: the control is not drawn.
import { strings } from '../lib/i18n';

interface Props {
  /** The page's language. */
  lang: string | undefined;
  /** The slot of the element the switch is a child of (the navigation drawer's `header`), where it has one. */
  into?: string;
}
const t = strings(Astro.props.lang);
---

<tanrei-switch class="docs-listing" slot={Astro.props.into} label={t.listing.showAll} data-docs-listing-switch />

<script>
  import '@tanrei/web/components/switch';
  import { LISTING_EVERYTHING, LISTING_KEY } from '../lib/listing.mjs';
  import { showEverything, showsEverything } from '../lib/list-filter';

  type Switch = HTMLElement & { checked: boolean };
  const controls = () => document.querySelectorAll<Switch>('[data-docs-listing-switch]');
  // What the head's script found before the first paint.
  for (const control of controls()) control.checked = showsEverything();

  document.addEventListener('change', (event) => {
    const control = event.target as Switch;
    if (!(control instanceof HTMLElement) || !control.matches('[data-docs-listing-switch]')) return;
    const everything = !!control.checked;
    try {
      if (everything) localStorage.setItem(LISTING_KEY, LISTING_EVERYTHING);
      else localStorage.removeItem(LISTING_KEY);
    } catch {}
    showEverything(everything);
    for (const other of controls()) other.checked = everything;
  });
</script>

<style is:global>
  /* Before the script above has run: a row shown on request is not drawn to a reader who has not asked for everything
     (the attribute is the head's script's, so nothing is hidden where no script runs). */
  :root[data-docs-listing='listed'] [data-docs-on-request] {
    display: none;
  }
  /* The switch is Tanrei's Switch, and its look is the switch's. Until the element is defined: its room, from the
     switch's own tokens — the track, the gap, then the label, which is the element's own attribute — so that nothing
     beside it moves when it is drawn. */
  .docs-listing:not(:defined) {
    box-sizing: border-box;
    display: inline-flex;
    max-inline-size: 100%;
    padding-block: max(0px, calc((var(--tanrei-comp-switch-track-height) - 1lh) / 2));
    padding-inline-start: calc(var(--tanrei-comp-switch-track-width) + var(--tanrei-comp-switch-label-gap));
    font: var(--tanrei-comp-switch-label-typescale-font);
    letter-spacing: var(--tanrei-comp-switch-label-typescale-letter-spacing);
    visibility: hidden;
  }
  .docs-listing:not(:defined)::before {
    content: attr(label);
  }
  /* In the sidebar it stands in the drawer's header, in the row of the menu button, which keeps its height: it is
     drawn with the drawer, and until the drawer is defined it has no box among the sidebar's plain links. */
  .docs-sidebar:not(:defined) > .docs-listing:not(:defined) {
    display: none;
  }
  /* Where no script runs nothing is hidden and nothing can be switched: the switch is not drawn, and takes no room. */
  @media (scripting: none) {
    .docs-listing:not(:defined) {
      display: none;
    }
  }
</style>

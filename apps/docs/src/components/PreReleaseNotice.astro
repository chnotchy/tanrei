---
// One honest notice, reused on every install page. Package coordinates come from tanrei.config.json; the words are
// the page's language's (lib/i18n.ts).
import Callout from './Callout.astro';
import { config } from '../lib/repo';
import { contentLang, fill, strings } from '../lib/i18n';

interface Props {
  /** The registry the package will be published to, e.g. "npm". */
  registry: string;
  /** Package coordinate as it will appear there. */
  pkg: string;
}
const { registry, pkg } = Astro.props;
const t = strings(contentLang(Astro));
const body = fill(t.preReleaseBody, { pkg, registry, name: config.name, version: config.version, repository: config.repository.public });
---

<Callout type="caution" title={t.preReleaseTitle}>
  <p set:html={body} />
</Callout>

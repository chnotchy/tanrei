{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tanrei.config.json",
    "tokens/**",
    "specs/**"
  ],
  "tasks": {
    "validate": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../tokens/**",
        "../../specs/**",
        "../../tanrei.config.json"
      ],
      "outputs": []
    },
    "generate": {
      "dependsOn": [
        "^generate"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../tokens/**",
        "../../specs/**",
        "../../tanrei.config.json"
      ],
      "outputs": [
        "generated/**",
        "src/generated/**",
        "custom-elements.json"
      ]
    },
    "clean": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "clean",
        "generate",
        "^build"
      ],
      "outputs": [
        "dist/**",
        "lib/**",
        ".build/**",
        "build/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "@tanrei/web#build": {
      "dependsOn": [
        "clean",
        "generate",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../tools/src/cli.js",
        "../tools/src/syntax.js"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@tanrei/studio#build:app": {
      "dependsOn": [
        "clean",
        "^build"
      ],
      "outputs": [
        "dist-app/**"
      ]
    },
    "@tanrei/cli#build": {
      "dependsOn": [
        "clean",
        "generate",
        "^build",
        "@tanrei/studio#build:app"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../web/src/generated/glyphs.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@tanrei/web#test:node": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "@tanrei/web#test": {
      "dependsOn": [
        "build",
        "test:node"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@tanrei/tools#validate": {
      "cache": false
    },
    "@tanrei/tools#generate": {
      "cache": false,
      "dependsOn": [
        "^generate"
      ]
    }
  }
}

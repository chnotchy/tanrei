{
  "tanrei": {
    "sys": {
      "typescale": {
        "$type": "typography",
        "$description": "Text styles by LEVEL: one display, headings 1–6 (= h1–h6), a body family (lead, p, small), labels and a caption for controls, code, and an eyebrow. Every family is monotonic in size; where a heading and a body role share a size, headings weigh 500 or more and body weighs 400. Emphasis is a weight step (`emphasis.*`), not a role.",
        "$extensions": {
          "dev.tanrei.vocabulary": {
            "rationale": "One product has a hero, six heading levels, three sizes of running text, text inside controls at two sizes and a caption, code at two sizes, and a kicker — and stresses any of them without changing its size or level.",
            "since": "0.1.0"
          },
          "dev.tanrei.llm": {
            "usage": "Text styles by level: display, heading-1…6 (h1…h6), body-large / body / body-small (lead, p, small), label / label-small / caption (controls and helper text), code / code-small, eyebrow. Each is a complete style: family, size, weight, line height, tracking.",
            "rules": [
              "Pick the LEVEL the text has in the page, not the size you want: an h2 is heading-2 even when it must look small — re-value the role in your layer instead.",
              "Use a role as a whole; do not combine one role's size with another's line height.",
              "To stress text without changing its level, ask the platform for the emphasized weight (the family's `emphasis.*` increment); do not pick a bigger role.",
              "Sizes follow dial.type.base with a per-role coefficient; pin one role with $value + reason only when a size is externally fixed (legal, contractual)."
            ]
          }
        },
        "display": {
          "$value": {
            "fontFamily": "{tanrei.ref.typeface.brand}",
            "fontSize": {
              "value": 48,
              "unit": "px"
            },
            "fontWeight": 450,
            "letterSpacing": {
              "value": -1.92,
              "unit": "px"
            },
            "lineHeight": 1.0833
          },
          "$extensions": {
            "dev.tanrei.derive": {
              "fontSize": {
                "fn": "mul",
                "of": "{tanrei.dial.type.base}",
                "by": 3,
                "exp": "{tanrei.dial.type.contrast}"
              },
              "letterSpacing": {
                "fn": "em",
                "by": -0.04
              }
            }
          },
          "$description": "The one hero size: a landing screen's statement, a splash. Not a heading level."
        },

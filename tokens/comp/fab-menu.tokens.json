{
  "tanrei": {
    "comp": {
      "fab-menu": {
        "$extensions": {
          "dev.tanrei.vocabulary": {
            "rationale": "One product offers two to six related creation actions from its screen's floating action button, at the emphasis and size of its FABs.",
            "since": "0.1.0"
          },
          "dev.tanrei.states": {
            "variants": [
              "filled",
              "tonal",
              "surface"
            ],
            "states": [
              "hovered",
              "focused",
              "pressed",
              "disabled"
            ],
            "perVariant": {
              "container.color": "color",
              "container.elevation": "shadow",
              "icon.color": "color",
              "state-layer.color": "color",
              "open.container.color": "color",
              "open.container.elevation": "shadow",
              "open.icon.color": "color",
              "open.state-layer.color": "color",
              "item.container.color": "color",
              "item.container.elevation": "shadow",
              "item.label.color": "color",
              "item.icon.color": "color",
              "item.state-layer.color": "color"
            },
            "perComponent": {
              "opacity": "number"
            }
          },
          "dev.tanrei.llm": {
            "usage": "Everything a FAB menu reads: per size the toggle's side, corners and icon size; the open toggle's corners; an item's height, corners, paddings, gap, label style and icon size; the column's gap and offset; the motion; and per variant (filled, tonal, surface) the colors and elevation of the closed toggle, the open toggle (open.) and an item (item.) in each state.",
            "rules": [
              "Use a FAB menu for two to six related actions that start something (create a document, a folder, an upload); use a FAB for one.",
              "Give the toggle a label and every item a label and an icon.",
              "The open toggle must differ from the closed one by more than its glyph; the default swaps its look.",
              "Restyle through these tokens in a layer; never through the FAB's tokens.",
              "state-layer.color, open.state-layer.color and item.state-layer.color are the colors hover, focus and press mix into the closed toggle, the open toggle and an item."
            ]
          },
          "dev.tanrei.axes": {
            "size": {
              "default": "medium",
              "values": [
                "small",
                "medium",
                "large"
              ],
              "members": [
                "container.size",
                "container.shape",
                "icon.size"
              ]
            },
            "variant": {
              "default": "filled",
              "from": "states"
            }
          }
        },
        "container": {
          "size": {
            "$type": "dimension",
            "$description": "The toggle's side, per size, as the floating action button's.",
            "small": {
              "$value": {
                "value": 40,
                "unit": "px"
              },
              "$extensions": {
                "dev.tanrei.derive": {
                  "fn": "mul",
                  "of": "{tanrei.dial.size.unit}",
                  "by": 10
                }
              }
            },
            "medium": {
              "$value": {
                "value": 48,
                "unit": "px"
              },
              "$extensions": {
                "dev.tanrei.derive": {
                  "fn": "mul",
                  "of": "{tanrei.dial.size.unit}",
                  "by": 12
                }
              }
            },
            "large": {
              "$value": {
                "value": 64,
                "unit": "px"
              },
              "$extensions": {
                "dev.tanrei.derive": {
                  "fn": "mul",
                  "of": "{tanrei.dial.size.unit}",
                  "by": 16
                }
              }
            }
          },
          "shape": {
            "$type": "dimension",
            "$description": "The closed toggle's corners, per size, as the floating action button's.",
            "small": {
              "$value": "{tanrei.sys.shape.corner.medium}"
            },
            "medium": {
              "$value": "{tanrei.sys.shape.corner.large}"
            },
            "large": {
              "$value": "{tanrei.sys.shape.corner.extra-large}"
            }
          },
          "shape-open": {
            "$type": "dimension",
            "$value": "{tanrei.sys.shape.corner.full}",
            "$description": "The open toggle's corners: round, so that it reads as a close button rather than the action it was."
          }
        },
        "icon": {
          "size": {
            "$type": "dimension",
            "$description": "The toggle's glyph, per size, as the floating action button's.",
            "small": {
              "$value": "{tanrei.sys.icon.small}"
            },
            "medium": {
              "$value": "{tanrei.sys.icon.medium}"
            },
            "large": {
              "$value": "{tanrei.sys.icon.large}"
            }
          }
        },
        "item": {
          "height": {
            "$type": "dimension",
            "$description": "An item's minimum height.",
            "$value": {
              "value": 48,
              "unit": "px"
            },
            "$extensions": {
              "dev.tanrei.derive": {
                "fn": "mul",
                "of": "{tanrei.dial.size.unit}",
                "by": 12
              }
            }
          },
          "shape": {
            "$type": "dimension",
            "$value": "{tanrei.sys.shape.corner.large}",
            "$description": "An item's corners."
          },
          "padding-inline-start": {
            "$type": "dimension",
            "$value": "{tanrei.sys.space.space200}",
            "$description": "Space before the icon."
          },
          "padding-inline-end": {
            "$type": "dimension",
            "$value": "{tanrei.sys.space.space250}",
            "$description": "Space after the label."
          },
          "gap": {
            "$type": "dimension",
            "$value": "{tanrei.sys.space.space100}",
            "$description": "Space between the icon and the label."
          },
          "label": {
            "typescale": {
              "$type": "typography",
              "$value": "{tanrei.sys.typescale.label}"
            }
          },
          "icon": {
            "size": {
              "$type": "dimension",
              "$value": "{tanrei.sys.icon.small}"
            }
          }
        },
        "list": {
          "gap": {
            "$type": "dimension",
            "$value": "{tanrei.sys.space.space100}",
            "$description": "Space between two items."
          },
          "offset": {
            "$type": "dimension",
            "$value": "{tanrei.sys.space.space100}",
            "$description": "Space between the lowest item and the toggle."
          }
        },
        "filled": {
          "container": {
            "color": {
              "$type": "color",
              "$value": "{tanrei.sys.color.primary}",
              "$description": "The toggle's fill while closed."
            },
            "elevation": {
              "$type": "shadow",
              "$value": "{tanrei.sys.elevation.level3}"
            }
          },
          "icon": {
            "color": {
              "$type": "color",
              "$value": "{tanrei.sys.color.on-primary}",
              "$description": "The toggle's glyph while closed."
            }
          },
          "state-layer": {
            "color": {
              "$type": "color",
              "$value": "{tanrei.comp.fab-menu.filled.icon.color}",
              "$description": "The color hover, focus and press mix into the closed toggle: its icon color."
            }
          },
          "open": {
            "container": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.secondary-container}",
                "$description": "The toggle's fill while open."
              },
              "elevation": {
                "$type": "shadow",
                "$value": "{tanrei.sys.elevation.level3}"
              }
            },
            "icon": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.on-secondary-container}",
                "$description": "The close glyph's color."
              }
            },
            "state-layer": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.comp.fab-menu.filled.open.icon.color}",
                "$description": "The color hover, focus and press mix into the open toggle: its icon color."
              }
            }
          },
          "item": {
            "container": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.primary}",
                "$description": "An item's fill."
              },
              "elevation": {
                "$type": "shadow",
                "$value": "{tanrei.sys.elevation.level2}"
              }
            },
            "label": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.on-primary}"
              }
            },
            "icon": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.on-primary}"
              }
            },
            "state-layer": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.comp.fab-menu.filled.item.label.color}",
                "$description": "The color hover, focus and press mix into an item: its label color."
              }
            }
          }
        },
        "tonal": {
          "container": {
            "color": {
              "$type": "color",
              "$value": "{tanrei.sys.color.secondary-container}",
              "$description": "The toggle's fill while closed."
            },
            "elevation": {
              "$type": "shadow",
              "$value": "{tanrei.sys.elevation.level3}"
            }
          },
          "icon": {
            "color": {
              "$type": "color",
              "$value": "{tanrei.sys.color.on-secondary-container}",
              "$description": "The toggle's glyph while closed."
            }
          },
          "state-layer": {
            "color": {
              "$type": "color",
              "$value": "{tanrei.comp.fab-menu.tonal.icon.color}",
              "$description": "The color hover, focus and press mix into the closed toggle: its icon color."
            }
          },
          "open": {
            "container": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.primary}",
                "$description": "The toggle's fill while open."
              },
              "elevation": {
                "$type": "shadow",
                "$value": "{tanrei.sys.elevation.level3}"
              }
            },
            "icon": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.on-primary}",
                "$description": "The close glyph's color."
              }
            },
            "state-layer": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.comp.fab-menu.tonal.open.icon.color}",
                "$description": "The color hover, focus and press mix into the open toggle: its icon color."
              }
            }
          },
          "item": {
            "container": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.secondary-container}",
                "$description": "An item's fill."
              },
              "elevation": {
                "$type": "shadow",
                "$value": "{tanrei.sys.elevation.level2}"
              }
            },
            "label": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.on-secondary-container}"
              }
            },
            "icon": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.on-secondary-container}"
              }
            },
            "state-layer": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.comp.fab-menu.tonal.item.label.color}",
                "$description": "The color hover, focus and press mix into an item: its label color."
              }
            }
          }
        },
        "surface": {
          "container": {
            "color": {
              "$type": "color",
              "$value": "{tanrei.sys.color.surface-container-lowest}",
              "$description": "The toggle's fill while closed."
            },
            "elevation": {
              "$type": "shadow",
              "$value": "{tanrei.sys.elevation.level3}"
            }
          },
          "icon": {
            "color": {
              "$type": "color",
              "$value": "{tanrei.sys.color.primary}",
              "$description": "The toggle's glyph while closed."
            }
          },
          "state-layer": {
            "color": {
              "$type": "color",
              "$value": "{tanrei.comp.fab-menu.surface.icon.color}",
              "$description": "The color hover, focus and press mix into the closed toggle: its icon color."
            }
          },
          "open": {
            "container": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.secondary-container}",
                "$description": "The toggle's fill while open."
              },
              "elevation": {
                "$type": "shadow",
                "$value": "{tanrei.sys.elevation.level3}"
              }
            },
            "icon": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.on-secondary-container}",
                "$description": "The close glyph's color."
              }
            },
            "state-layer": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.comp.fab-menu.surface.open.icon.color}",
                "$description": "The color hover, focus and press mix into the open toggle: its icon color."
              }
            }
          },
          "item": {
            "container": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.surface-container-lowest}",
                "$description": "An item's fill."
              },
              "elevation": {
                "$type": "shadow",
                "$value": "{tanrei.sys.elevation.level2}"
              }
            },
            "label": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.on-surface}"
              }
            },
            "icon": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.primary}"
              }
            },
            "state-layer": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.comp.fab-menu.surface.item.label.color}",
                "$description": "The color hover, focus and press mix into an item: its label color."
              }
            }
          }
        },
        "motion": {
          "state-duration": {
            "$type": "duration",
            "$value": "{tanrei.sys.motion.duration.short3}"
          },
          "state-easing": {
            "$type": "cubicBezier",
            "$value": "{tanrei.sys.motion.easing.standard}"
          },
          "feedback-duration": {
            "$type": "duration",
            "$value": "{tanrei.sys.motion.duration.long1}",
            "$description": "How long the ripple takes to spread."
          },
          "open-duration": {
            "$type": "duration",
            "$value": "{tanrei.sys.motion.duration.medium1}",
            "$description": "The toggle's change and each item's entrance when the menu opens."
          },
          "open-easing": {
            "$type": "cubicBezier",
            "$value": "{tanrei.sys.motion.easing.emphasized-decelerate}"
          },
          "close-duration": {
            "$type": "duration",
            "$value": "{tanrei.sys.motion.duration.short3}",
            "$description": "The items leaving together and the toggle changing back."
          },
          "close-easing": {
            "$type": "cubicBezier",
            "$value": "{tanrei.sys.motion.easing.emphasized-accelerate}"
          },
          "stagger": {
            "$type": "duration",
            "$value": "{tanrei.sys.motion.duration.stagger}",
            "$description": "The delay between one item's entrance and the next."
          }
        }
      }
    }
  }
}

            "$type": "cubicBezier",
            "$value": "{tanrei.sys.motion.easing.state}"
          },
          "feedback-duration": {
            "$type": "duration",
            "$value": "{tanrei.sys.motion.role.feedback}",
            "$description": "How long the answer to a press takes to spread when sys.behavior.pressed-feedback is ripple: the pressed layer grows from the point of contact over this time, with state-easing. Unused by the other choices."
          },
          "busy-cycle-duration": {
            "$type": "duration",
            "$value": "{tanrei.comp.loading-indicator.motion.cycle-duration}",
            "$description": "One turn of the busy arc (BTN-36): the loading indicator's. Under reduced motion it does not turn, and its opacity eases once per this time instead."
          }
        },
        "busy": {
          "$description": "What a busy Button draws in place of its label and icon (BTN-36): the loading indicator's arc, in the label color, in the icon's box.",
          "$extensions": {
            "dev.tanrei.vocabulary": {
              "rationale": "One product keeps a button on screen and focused while the action it started is under way (a save, a send), and must show that it is working rather than disable it and drop the person's focus.",
              "since": "0.1.0"
            }
          },
          "indicator": {
            "thickness": {
              "$type": "dimension",
              "$value": "{tanrei.comp.loading-indicator.indicator.thickness.small}",
              "$description": "The arc's stroke: the small loading indicator's."
            }
          }
        },
        "tone": {
          "$description": "A Button its host draws on a colored surface of the host's own — a status callout's, an inverse or status snackbar's — and gives the content color of that surface (a tone, BTN-45): its label, icon and state layer take that color, and its container, where its variant draws one at rest, is that color made translucent, so that it reads on every such surface where the variant's own container would clash with it.",
          "$extensions": {
            "dev.tanrei.vocabulary": {
              "rationale": "One product draws buttons on colored surfaces of its own (a status notice, an inverse notification) as well as on its page; on such a surface a button's own container clashes with the surface and its content colors may not hold contrast there, so it is drawn in the surface's own content color, its container a translucent layer of that color.",
              "since": "0.1.0"
            }
          },
          "container": {
            "opacity": {
              "$type": "number",
              "$value": "{tanrei.sys.state.selected-state-layer-opacity}",
              "$description": "The opacity of the tone's color that a toned Button's container is drawn in (BTN-45), where its variant draws a container at rest; an outlined Button's edge takes the same. The quiet selection's layer: a layer of a content color that stays at rest, twice the hover layer, so that hover, focus and press laid over it at the system's state-layer opacities stand apart from it by the same step on any surface."
            }
          }
        }

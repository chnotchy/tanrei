          "size-without-label": {
            "$type": "dimension",
            "$description": "The icon box of an icon-only button, per size. The same as the icon beside a label by default.",
            "$extensions": {
              "dev.tanrei.vocabulary": {
                "rationale": "One product draws a glyph that stands alone larger than one that sits beside a label: alone it carries the whole meaning of the action, beside text it only reinforces it. For example, 18 beside a label and 24 alone.",
                "since": "0.1.0"
              }
            },
            "small": {
              "$value": "{tanrei.comp.button.icon.size.small}"
            },
            "medium": {
              "$value": "{tanrei.comp.button.icon.size.medium}"
            },
            "large": {
              "$value": "{tanrei.comp.button.icon.size.large}"
            }
          }
        },

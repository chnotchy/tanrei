          "state-duration": {
            "$type": "duration",
            "$description": "How long a change of state takes. It follows the size (small over the compact role, medium over the default role, large over the large role): a smaller control changes state sooner.",
            "small": {
              "$value": "{tanrei.sys.motion.role.state.compact}"
            },
            "medium": {
              "$value": "{tanrei.sys.motion.role.state.default}"
            },

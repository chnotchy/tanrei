              "dev.tanrei.vocabulary": {
                "rationale": "One product draws a glyph that stands alone larger than one that sits beside a label: alone it carries the whole meaning of the action, beside text it only reinforces it. For example, 18 beside a label and 24 alone.",
                "since": "0.1.0"
              }

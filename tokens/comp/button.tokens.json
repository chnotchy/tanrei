        "icon": {
          "size": {
            "$type": "dimension",
            "$description": "The icon box beside a label, per size. By default a small button draws a small glyph and a medium one the standard glyph; a large one keeps the standard glyph, because the next step would not leave room in its height.",
            "small": {
              "$value": "{tanrei.sys.icon.small}"
            },
            "medium": {
              "$value": "{tanrei.sys.icon.medium}"
            },
            "large": {

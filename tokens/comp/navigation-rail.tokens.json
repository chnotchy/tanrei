{
  "tanrei": {
    "comp": {
      "navigation-rail": {
        "$extensions": {
          "dev.tanrei.vocabulary": {
            "rationale": "One product moves between its top-level destinations from the side of a medium or large screen, shows which one is current, marks one that has something new, can make one unavailable, and puts its menu or main action above them.",
            "since": "0.1.0"
          },
          "dev.tanrei.states": {
            "variants": [
              "unselected",
              "selected"
            ],
            "states": [
              "hovered",
              "focused",
              "pressed",
              "disabled"
            ],
            "perVariant": {
              "item.container.color": "color",
              "item.icon.color": "color",
              "item.label.color": "color",
              "item.state-layer.color": "color"
            },
            "perComponent": {
              "opacity": "number"
            }
          },
          "dev.tanrei.llm": {
            "usage": "Everything a navigation rail reads: the rail's container, width, end edge, padding and the gaps below the header and between destinations, the item geometry (the item container that is the active indicator, the icon size, the label style and gap), and for each condition (unselected, selected) the item container / icon / label colors in each state.",
            "rules": [
              "The selected destination is drawn from the selected parts; every other destination from the unselected parts. Never pick a look by hand.",
              "Selected must differ from unselected by more than the icon's fill: an active indicator, a stronger color, or both.",
              "Hover, focus and press show on the item container (the active indicator's box), never on the whole cell.",
              "A look that draws no item container at rest draws none when disabled.",
              "Restyle through these tokens in a layer; never fork the component.",
              "Each condition's item.state-layer.color is the color hover, focus and press mix into its item container; it aliases that condition's icon color."
            ]
          },
          "dev.tanrei.axes": {
            "condition": {
              "default": "unselected",
              "from": "states"
            }
          }
        },
        "container": {
          "color": {
            "$type": "color",
            "$value": "{tanrei.sys.color.surface}"
          },
          "elevation": {
            "$type": "shadow",
            "$value": "{tanrei.sys.elevation.level0}"
          },
          "width": {
            "$type": "dimension",
            "$value": {
              "value": 80,
              "unit": "px"
            },
            "$extensions": {
              "dev.tanrei.derive": {
                "fn": "mul",
                "of": "{tanrei.dial.size.unit}",
                "by": 20
              }
            },
            "$description": "The rail's width, not counting the system inset at its start."
          },
          "padding-block": {
            "$type": "dimension",
            "$description": "Above the header (or the first destination) and below the last destination.",
            "$value": "{tanrei.sys.space.space200}"
          },
          "gap": {
            "$type": "dimension",
            "$description": "Between two destinations.",
            "$value": "{tanrei.sys.space.space100}"
          }
        },
        "header": {
          "gap": {
            "$type": "dimension",
            "$description": "From the header slot to the first destination.",
            "$value": "{tanrei.sys.space.space300}"
          }
        },
        "outline": {
          "color": {
            "$type": "color",
            "$description": "The rail's end edge.",
            "$value": "{tanrei.sys.color.outline-variant}"
          },
          "width": {
            "$type": "dimension",
            "$value": "{tanrei.sys.border.hairline}"
          }
        },
        "item": {
          "container": {
            "width": {
              "$type": "dimension",
              "$value": {
                "value": 56,
                "unit": "px"
              },
              "$extensions": {
                "dev.tanrei.derive": {
                  "fn": "mul",
                  "of": "{tanrei.dial.size.unit}",
                  "by": 14
                }
              },
              "$description": "The item container: the active indicator's box behind the icon, which also carries hover, focus and press."
            },
            "height": {
              "$type": "dimension",
              "$value": {
                "value": 32,
                "unit": "px"
              },
              "$extensions": {
                "dev.tanrei.derive": {
                  "fn": "mul",
                  "of": "{tanrei.dial.size.unit}",
                  "by": 8
                }
              }
            },
            "shape": {
              "$type": "dimension",
              "$value": "{tanrei.sys.shape.corner.small}"
            }
          },
          "icon": {
            "size": {
              "$type": "dimension",
              "$description": "The icon of every destination.",
              "$value": "{tanrei.sys.icon.medium}"
            }
          },
          "label": {
            "typescale": {
              "$type": "typography",
              "$value": "{tanrei.sys.typescale.label-small}"
            }
          },
          "gap": {
            "$type": "dimension",
            "$description": "From the item container to the label below it.",
            "$value": "{tanrei.sys.space.space50}"
          }
        },
        "unselected": {
          "item": {
            "container": {
              "color": {
                "$type": "color",
                "$value": {
                  "colorSpace": "srgb",
                  "components": [
                    0,
                    0,
                    0
                  ],
                  "alpha": 0,
                  "hex": "#000000"
                },
                "$extensions": {
                  "dev.tanrei.derive": {
                    "fixed": "An unselected destination draws no active indicator; hover, focus and press mix into it."
                  }
                }
              }
            },
            "icon": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.on-surface-variant}"
              }
            },
            "label": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.on-surface-variant}"
              }
            },
            "state-layer": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.comp.navigation-rail.unselected.item.icon.color}"
              }
            }
          }
        },
        "selected": {
          "item": {
            "container": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.secondary-container}"
              }
            },
            "icon": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.on-secondary-container}"
              }
            },
            "label": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.sys.color.on-surface}"
              }
            },
            "state-layer": {
              "color": {
                "$type": "color",
                "$value": "{tanrei.comp.navigation-rail.selected.item.icon.color}"
              }
            }
          }
        },
        "motion": {
          "state-duration": {
            "$type": "duration",
            "$value": "{tanrei.sys.motion.duration.short3}"
          },
          "state-easing": {
            "$type": "cubicBezier",
            "$value": "{tanrei.sys.motion.easing.standard}"
          },
          "feedback-duration": {
            "$type": "duration",
            "$value": "{tanrei.sys.motion.duration.long1}",
            "$description": "How long the answer to a press takes to spread when sys.behavior.pressed-feedback is ripple (as Button's)."
          },
          "selection-duration": {
            "$type": "duration",
            "$value": "{tanrei.sys.motion.spring.standard.fast-spatial.duration}",
            "$description": "How long the active indicator takes to grow in (and the previous one to fade out), and labels to move, when the selection changes."
          },
          "selection-easing": {
            "$type": "cubicBezier",
            "$value": "{tanrei.sys.motion.spring.standard.fast-spatial.easing}"
          }
        }
      }
    }
  }
}

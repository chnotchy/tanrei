{
  "tanrei": {
    "sys": {
      "space": {
        "$type": "dimension",
        "$extensions": {
          "dev.tanrei.vocabulary": {
            "rationale": "One product uses a graded set of distances: tight inside controls, looser between groups, generous between sections.",
            "since": "0.1.0"
          },
          "dev.tanrei.llm": {
            "usage": "The only distances allowed for padding, gaps and margins. spaceN is N% of dial.space.unit × 100 (space100 = one unit, 8px by default).",
            "rules": [
              "Never write a literal distance; pick the nearest step.",
              "To change one component's spacing, re-point its comp token to another step or use {\"scale\": n}; do not add steps."
            ]
          }
        },
        "space0": {
          "$value": {
            "value": 0,
            "unit": "px"
          },
          "$extensions": {
            "dev.tanrei.derive": {
              "fn": "mul",
              "of": "{tanrei.dial.space.unit}",
              "by": 0
            }
          }
        },

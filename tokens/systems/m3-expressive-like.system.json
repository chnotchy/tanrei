    "tanrei.comp.button.container.padding-inline-narrow.large": {"$value": "{tanrei.sys.space.space100}", "reason": "This preset's own narrow width, where the default system's narrow icon-only button is its glyph and an inset of 4 on each side; moving it is a fidelity decision for this preset."},

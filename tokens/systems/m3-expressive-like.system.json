{
  "$schema": "../schema/system.schema.json",
  "id": "m3-expressive-like",
  "name": "M3 Expressive-like (Material 3 Expressive-inspired)",
  "extends": "m3-like",
  "description": "m3-like with the five button sizes of Material 3 Expressive — extra small to extra large, each with its own paddings, icon size, icon-to-label gap and outline width. Colors, type, shape and states are m3-like's.",
  "attribution": {
    "inspiredBy": "Material Design 3 Expressive",
    "sources": [
      {
        "name": "androidx.compose.material3 tokens",
        "license": "Apache-2.0",
        "url": "https://github.com/androidx/androidx/tree/androidx-main/compose/material3/material3/src/commonMain/kotlin/androidx/compose/material3/tokens"
      }
    ],
    "disclaimer": "Tanrei is not affiliated with, endorsed by, or sponsored by Google. \"Material Design\" is Google's; this preset is an independent reproduction of published, Apache-2.0 licensed token values."
  },
  "vocabulary": {
    "tanrei.comp.button.size.xsmall": {
      "from": "small",
      "rationale": "Material 3 Expressive has five button sizes; this is its smallest (32dp)."
    },
    "tanrei.comp.button.size.xlarge": {
      "from": "large",
      "rationale": "Material 3 Expressive has five button sizes; this is its largest (136dp)."
    }
  },

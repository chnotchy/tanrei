    "tanrei.comp.button.container.gap.xsmall": {"derive": {"fn": "mul", "of": "{tanrei.dial.space.unit}", "by": 1.0}},
    "tanrei.comp.button.icon.size.xsmall": {"derive": {"fn": "mul", "of": "{tanrei.dial.size.unit}", "by": 5.0}},

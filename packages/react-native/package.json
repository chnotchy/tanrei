{
  "name": "@tanrei/react-native",
  "version": "0.1.0-next.0",
  "description": "Tanrei design system — React Native components (pure TypeScript, no native modules).",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/chnotchy/tanrei.git", "directory": "packages/react-native" },
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./systems/*": {
      "source": "./src/generated/systems/*.ts",
      "types": "./lib/typescript/src/generated/systems/*.d.ts",
      "default": "./lib/module/generated/systems/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["src", "lib", "README.md", "NOTICE", "!**/__tests__", "!src/testing"],
  "sideEffects": false,
  "scripts": {
    "build": "bob build",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p example/tsconfig.typecheck.json --noEmit",
    "generate:fixtures": "node scripts/acme-fixture.mjs"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.78.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@types/react": "^19.3.0",
    "jest": "^29.7.0",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.1",
    "test-renderer": "^1.3.0",
    "typescript": "^7.0.2"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/{__tests__,__fixtures__,__mocks__,testing}/**",
    "targets": [
      ["module", { "esm": true }],
      ["typescript", { "project": "tsconfig.build.json" }]
    ]
  }
}

{
  "name": "@tanrei/studio",
  "private": true,
  "version": "0.0.0",
  "description": "Tanrei Theme Studio: four views — essentials, groups, every token, source — over one <id>.system.json layer. Mounts in any page; ships a standalone app for `tanrei studio`.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.js",
    "./adapter-http": "./src/adapter-http.js",
    "./vite": "./vite-plugin.js",
    "./studio.css": "./src/studio.css"
  },
  "scripts": {
    "dev:app": "node ../../packages/tools/src/font-faces.js app/fonts.generated.css && vite --config app/vite.config.js",
    "build:app": "node ../../packages/tools/src/font-faces.js app/fonts.generated.css --check-systems && vite build --config app/vite.config.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "pnpm typecheck",
    "test:node": "node --test \"test/*.test.js\"",
    "test:browser": "node test/browser/run.mjs",
    "test": "pnpm test:node && pnpm test:browser"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/material-symbols-outlined": "^5.3.7",
    "@fontsource-variable/material-symbols-rounded": "^5.3.7",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@tanrei/token-engine": "workspace:*",
    "@tanrei/tokens-build": "workspace:*",
    "@tanrei/web": "workspace:*",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}

{
  "name": "@tanrei/react",
  "version": "0.1.0-next.0",
  "description": "Tanrei design system — React bindings for the Web Components (generated from the custom elements manifest).",
  "license": "Apache-2.0",
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/chnotchy/tanrei.git", "directory": "packages/react" },
  "exports": {
    ".": { "types": "./dist/entries/generated/index.d.ts", "default": "./dist/entries/generated/index.js" },
    "./advanced": { "types": "./dist/entries/generated/advanced.d.ts", "default": "./dist/entries/generated/advanced.js" },
    "./all": { "types": "./dist/entries/generated/all.d.ts", "default": "./dist/entries/generated/all.js" },
    "./cupertino": { "types": "./dist/entries/generated/cupertino.d.ts", "default": "./dist/entries/generated/cupertino.js" },
    "./m3-expressive-like": { "types": "./dist/entries/generated/m3-expressive-like.d.ts", "default": "./dist/entries/generated/m3-expressive-like.js" },
    "./m3-like": { "types": "./dist/entries/generated/m3-like.d.ts", "default": "./dist/entries/generated/m3-like.js" }
  },
  "sideEffects": false,
  "files": ["dist", "README.md", "NOTICE"],
  "scripts": {
    "generate": "node scripts/generate.js",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p test/tsconfig.json && node ../tools/src/run-node-tests.js \"test/*.test.mjs\""
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@tanrei/web": "workspace:*"
  },
  "peerDependencies": { "react": ">=18" },
  "devDependencies": { "@types/react": "^19.0.0", "esbuild": "^0.28.2", "react": "^19.0.0", "typescript": "^7.0.2" }
}
